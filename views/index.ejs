    <script>
    // ===== HOME HUB DYNAMIC CONTENT =====
    (function() {
        let currentUser = null;

        function waitForFirebase(timeout = 8000) {
            return new Promise((resolve) => {
                if (window.auth && window.db && window.collection) return resolve(true);
                const start = Date.now();
                const t = setInterval(() => {
                    if (window.auth && window.db && window.collection) {
                        clearInterval(t); resolve(true);
                    } else if (Date.now() - start > timeout) {
                        clearInterval(t); resolve(false);
                    }
                }, 100);
            });
        }

        // -- Leaderboard --
        async function loadLeaderboard() {
            const ok = await waitForFirebase();
            if (!ok || !window.collection || !window.getDocs) return;
            try {
                const snap = await window.getDocs(window.collection(window.db, 'conductores'));
                const lb = document.getElementById('homeLeaderboard');
                if (!lb) return;
                
                const list = [];
                snap.forEach(doc => {
                    const data = doc.data();
                    const email = String(data.email || '').trim().toLowerCase();
                    const isFounder = email === 'pantergamey@gmail.com';
                    list.push({
                        nombre_usuario: data.nombre_usuario,
                        username: data.username,
                        displayName: data.displayName,
                        coins: Math.max(Number(data.coins || 0), Number(data.saldo || 0)),
                        avatar: data.avatar || '😊',
                        avatarImg: data.avatarImg || '',
                        role: isFounder ? 'founder_ceo' : (data.role || 'viewer'),
                        betaTesterStatus: data.betaTesterStatus || '',
                        email: email,
                        streak: Number(data.streak || 0),
                        country: data.country || 'Colombia',
                        favoriteProject: data.favoriteProject || 'Nuestra Tierra Job Simulator',
                        bio: data.bio || '¡Hola! Soy un conductor orgulloso de Panter Studio.',
                        createdAt: data.createdAt || ''
                    });
                });
                
                // Ordenar por monedas descendente
                list.sort((a, b) => b.coins - a.coins);
                
                // Mostrar los mejores 5
                let top5 = list.slice(0, 5);
                const founderItem = list.find(u => String(u.email || '').toLowerCase() === 'pantergamey@gmail.com');
                const hasFounder = top5.some(u => String(u.email || '').toLowerCase() === 'pantergamey@gmail.com');
                if (founderItem && !hasFounder) {
                    top5.push(founderItem);
                }
                
                // Hacer la lista accesible para el click handler
                window.leaderboardCachedList = top5;

                lb.innerHTML = '';
                const medals = [
                    '<img src="/recursos/iconos/1er-premio.png" alt="🥇" style="width:20px;height:20px;vertical-align:middle;">',
                    '<img src="/recursos/iconos/segundo-lugar.png" alt="🥈" style="width:20px;height:20px;vertical-align:middle;">',
                    '<img src="/recursos/iconos/3er-lugar.png" alt="🥉" style="width:20px;height:20px;vertical-align:middle;">'
                ];
                const topClasses = ['top-1','top-2','top-3'];
                
                 const ROLE_LABELS = {
                    founder_ceo: 'Fundador',
                    director: 'Director',
                    administrador: 'Admin',
                    programador: 'Dev',
                    modelador: '3D Mod',
                    usuario: 'Miembro',
                    viewer: 'Miembro',
                    vip: 'VIP',
                    community_manager: 'CM',
                    support_ops: 'Soporte',
                    youtuber: 'Youtuber',
                    streamer: 'Streamer'
                };

                const roleBadgeTones = {
                    founder_ceo: 'color: #fde68a; border: 1px solid rgba(251,191,36,.4); background: linear-gradient(135deg, rgba(251,191,36,.25), rgba(28,33,46,.8)); text-shadow: 0 0 4px rgba(251,191,36,.5); box-shadow: 0 0 8px rgba(251,191,36,.25);',
                    director: 'color: #fca5a5; border: 1px solid rgba(239,68,68,.3); background: rgba(239,68,68,.08);',
                    administrador: 'color: #80f0ff; border: 1px solid rgba(0,240,255,.3); background: rgba(0,240,255,.08);',
                    programador: 'color: #fda4af; border: 1px solid rgba(248,113,113,.2); background: rgba(248,113,113,.08);',
                    modelador: 'color: #93c5fd; border: 1px solid rgba(96,165,250,.2); background: rgba(96,165,250,.08);',
                    community_manager: 'color: #d8b4fe; border: 1px solid rgba(168,85,247,.2); background: rgba(168,85,247,.08);',
                    vip: 'color: #fde68a; border: 1px solid rgba(251,191,36,.2); background: rgba(251,191,36,.08);',
                    youtuber: 'color: #fda4af; border: 1px solid rgba(248,113,113,.2); background: rgba(248,113,113,.08);',
                    streamer: 'color: #fda4af; border: 1px solid rgba(248,113,113,.2); background: rgba(248,113,113,.08);',
                    support_ops: 'color: #86efac; border: 1px solid rgba(74,222,128,.2); background: rgba(74,222,128,.08);'
                };

                let idx = -1;
                let rank = 0;
                top5.forEach(d => {
                    idx++;
                    rank++;
                    const username = d.nombre_usuario || d.username || d.displayName || 'Anónimo';
                    const coins = d.coins;
                    const cls = rank <= 3 ? topClasses[rank-1] : '';
                    const medal = d.role === 'founder_ceo' ? '👑' : (rank <= 3 ? medals[rank-1] : rank);
                    
                    let avatarHtml = `<span class="leaderboard-avatar">👤</span>`;
                    if (d.avatarImg) {
                        avatarHtml = `<img src="${d.avatarImg}" style="width:22px;height:22px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,0.1);flex-shrink:0;margin-right:2px;">`;
                    } else if (d.avatar) {
                        avatarHtml = `<span class="leaderboard-avatar" style="font-size:1rem;margin-right:2px;">${d.avatar}</span>`;
                    }

                    const betaBadge = d.betaTesterStatus === 'approved' ? `<span style="font-size:0.55rem;padding:0px 4px;border-radius:3px;font-weight:700;letter-spacing:0.3px;color:#86efac; border:1px solid rgba(16,185,129,.2); background:rgba(16,185,129,.08);" title="Beta Tester Oficial">Beta</span>` : '';
                    
                    const role = String(d.role || 'viewer').toLowerCase();
                    const roleLabel = ROLE_LABELS[role] || '';
                    const roleBadge = (roleLabel && role !== 'viewer' && role !== 'usuario') ? `<span style="font-size:0.55rem;padding:0px 4px;border-radius:3px;font-weight:700;letter-spacing:0.3px;${roleBadgeTones[role] || 'color:var(--text-secondary);border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.05);'}">${roleLabel}</span>` : '';

                    let rowStyle = 'padding: 0.5rem 0.75rem;';
                    let nameStyle = 'font-size:0.8rem; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:90px;';
                    
                    const isBeta = d.betaTesterStatus === 'approved';

                    if (role === 'founder_ceo') {
                        // Golden effect
                        rowStyle += ' background: linear-gradient(95deg, rgba(251,191,36,0.12), rgba(20,24,35,0.7)); border-color: rgba(251,191,36,0.45); box-shadow: 0 0 12px rgba(251,191,36,0.25);';
                        nameStyle += ' color: #fbbf24; font-weight: 800; text-shadow: 0 0 8px rgba(251,191,36,0.4);';
                    } else if (role === 'director') {
                        rowStyle += ' background: linear-gradient(95deg, rgba(239,68,68,0.1), rgba(20,24,35,0.7)); border-color: rgba(239,68,68,0.4); box-shadow: 0 0 10px rgba(239,68,68,0.22);';
                        nameStyle += ' color: #fca5a5; font-weight: 700; text-shadow: 0 0 8px rgba(239,68,68,0.3);';
                    } else if (role === 'administrador') {
                        rowStyle += ' background: linear-gradient(95deg, rgba(0,240,255,0.1), rgba(20,24,35,0.7)); border-color: rgba(0,240,255,0.45); box-shadow: 0 0 10px rgba(0,240,255,0.22);';
                        nameStyle += ' color: #80f0ff; font-weight: 700; text-shadow: 0 0 8px rgba(0,240,255,0.3);';
                    } else if (role === 'programador' || role === 'modelador') {
                        rowStyle += ' background: linear-gradient(95deg, rgba(0,176,255,0.08), rgba(20,24,35,0.7)); border-color: rgba(0,176,255,0.4); box-shadow: 0 0 10px rgba(0,176,255,0.2);';
                        nameStyle += ' color: #e0f7ff;';
                    } else if (role === 'community_manager') {
