        // -- Devlogs --
        async function loadDevlogs() {
            const ok = await waitForFirebase();
            if (!ok || !window.query || !window.orderBy || !window.limit || !window.getDocs) return;
            try {
                const q = window.query(
                    window.collection(window.db, 'devlogs'),
                    window.orderBy('createdAt', 'desc'),
                    window.limit(3)
                );
                const snap = await window.getDocs(q);
                const grid = document.getElementById('homeDevlogsGrid');
                if (!grid) return;
                if (snap.empty) {
                    grid.innerHTML = '<p style="font-size:0.85rem;color:var(--text-muted);text-align:center;padding:1rem;">No hay novedades aún.</p>';
                    return;
                }
                grid.innerHTML = '';
                snap.forEach(doc => {
                    const d = doc.data();
                    const title = d.title || 'Sin título';
                    const summary = d.summary || d.body?.substring(0,120) || '';
                    const img = d.imageUrl || 'https://i.imgur.com/1IRRyFY.jpeg';
                    const date = d.createdAt ? new Date(d.createdAt.toDate ? d.createdAt.toDate() : d.createdAt).toLocaleDateString('es-CO', {day:'numeric',month:'short'}) : '';
                    const tag = d.tag || 'UPDATE';
                    grid.innerHTML += `
                        <a href="pages/actualizaciones" class="ix-news-card">
                            <div class="ix-news-img-wrap">
                                <img class="ix-news-img" src="${img}" alt="${title}" onerror="this.src='https://i.imgur.com/1IRRyFY.jpeg'">
                            </div>
                            <div class="ix-news-body">
                                <span class="ix-news-tag">${tag}</span>
                                <p class="ix-news-card-title">${title}</p>
                            </div>
                        </a>`;
                });
            } catch(e) {
                console.warn('Devlogs error:', e);
                const grid = document.getElementById('homeDevlogsGrid');
                if (grid) grid.innerHTML = '<p style="font-size:0.85rem;color:var(--text-muted);">No se pudieron cargar las novedades.</p>';
            }
        }

        async function loadPreregStats() {
            // Load "Me Interesa" counter real-time
            const ok = await waitForFirebase();
            if (!ok || !window.query || !window.collection || !window.where || !window.onSnapshot) return;
            try {
                const q = window.query(window.collection(window.db, 'conductores'), window.where('interested', '==', true));
                window.onSnapshot(q, (snap) => {
                    const total = snap.size;
                    const statEl = document.getElementById('statRegistrados');
                    const widgetEl = document.getElementById('widgetInteresados');
                    if (statEl) statEl.textContent = total.toLocaleString();
                    if (widgetEl) widgetEl.textContent = total.toLocaleString();
                }, (e) => {
                    console.warn('Interesados listener error:', e);
                });
            } catch(e) { console.warn('Interesados counter error:', e); }
        }

        // -- User account widget --
        async function loadAccountWidget() {
            const ok = await waitForFirebase();
            if (!ok) return;
            window.auth.onAuthStateChanged(async (user) => {
                currentUser = user;
                const nameEl = document.getElementById('hubAccountName');
                const statusEl = document.getElementById('hubAccountStatus');
                const avatarEl = document.getElementById('hubAccountAvatar');
                const coinsEl = document.getElementById('hubCoins');
                const emeraldsEl = document.getElementById('hubEmeralds');
                const gamesEl = document.getElementById('hubGamesPlayed');
                const rankEl = document.getElementById('hubRank');
                const lbSelf = document.getElementById('lbSelfRow');

                if (user) {
                    if (nameEl) nameEl.textContent = user.displayName || 'Jugador';
                    if (statusEl) statusEl.textContent = 'Sesión activa';
                    if (avatarEl && user.photoURL) {
                        avatarEl.innerHTML = `<img src="${user.photoURL}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" alt="Avatar">`;
                    }
                    // Load user data from Firestore
                    try {
                        const docSnap = await window.getDoc(window.fsDoc(window.db, 'conductores', user.uid));
                        if (docSnap.exists()) {
                            const d = docSnap.data();
                            if (coinsEl) coinsEl.textContent = (d.coins || 0).toLocaleString();
                            if (emeraldsEl) emeraldsEl.textContent = (d.esmeraldas !== undefined ? d.esmeraldas : 0).toLocaleString();
                            if (gamesEl) {
                                // load streak/game count
                                gamesEl.textContent = (d.streak || 0) + ' días';
                            }
                            if (rankEl) rankEl.textContent = d.level ? (d.level.charAt(0).toUpperCase() + d.level.slice(1)) : 'Visitante';
                            if (nameEl) nameEl.textContent = d.nombre_usuario || d.username || user.displayName || 'Jugador';
                            // Show leaderboard self position
                            if (lbSelf) lbSelf.textContent = `Tu posición: buscando... · ${(d.coins||0).toLocaleString()} 🪙`;
                        }
                    } catch(e) { console.warn('Load user widget details error:', e); }
                } else {
                    currentUser = null;
                    if (nameEl) nameEl.textContent = 'Invitado';
                    if (statusEl) statusEl.textContent = 'No has iniciado sesión';
                    if (coinsEl) coinsEl.textContent = '—';
                    if (emeraldsEl) emeraldsEl.textContent = '—';
                    if (gamesEl) gamesEl.textContent = '—';
                    if (rankEl) rankEl.textContent = '—';
                    if (lbSelf) lbSelf.textContent = 'Inicia sesión para ver tu posición';
                }
            });
        }

