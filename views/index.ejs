        // -- Load Community Announcements --
        // -- Toggle Announcement Like --
        async function toggleAnnouncementLike(annId) {
            if (!currentUser) {
                const modal = document.getElementById('authModal');
                if (modal) {
                    modal.hidden = false;
                    document.body.style.overflow = 'hidden';
                } else {
                    alert('Debes iniciar sesión para reaccionar a los anuncios.');
                }
                return;
            }

            const cacheKey = 'ps_announcements_cache';
            let liveUpdated = false;
            const uid = currentUser.uid;

            // Online update via Firestore
            const ok = await waitForFirebase();
            if (ok && window.db && window.fsDoc && window.getDoc && window.updateDoc) {
                try {
                    const docRef = window.fsDoc(window.db, 'announcements', annId);
                    const snap = await window.getDoc(docRef);
                    if (snap.exists()) {
                        const data = snap.data();
                        let likes = Array.isArray(data.likes) ? data.likes : [];
                        if (likes.includes(uid)) {
                            likes = likes.filter(id => id !== uid);
                        } else {
                            likes.push(uid);
                        }
                        await window.updateDoc(docRef, { likes: likes });
                        liveUpdated = true;
                        
                        // Update cache
                        const cached = localStorage.getItem(cacheKey);
                        if (cached) {
                            try {
                                const parsed = JSON.parse(cached);
                                const idx = parsed.findIndex(a => a.id === annId);
                                if (idx !== -1) {
                                    parsed[idx].likes = likes;
                                    localStorage.setItem(cacheKey, JSON.stringify(parsed));
                                }
                            } catch(e) {}
                        }
                    }
                } catch(e) {
                    console.warn('Firestore like toggle error:', e);
                }
            }

            // Fallback / Offline local update
            if (!liveUpdated) {
                try {
                    const cached = localStorage.getItem(cacheKey);
                    if (cached) {
                        const parsed = JSON.parse(cached);
                        const idx = parsed.findIndex(a => a.id === annId);
                        if (idx !== -1) {
                            let likes = Array.isArray(parsed[idx].likes) ? parsed[idx].likes : [];
                            if (likes.includes(uid)) {
                                likes = likes.filter(id => id !== uid);
                            } else {
                                likes.push(uid);
                            }
                            parsed[idx].likes = likes;
                            localStorage.setItem(cacheKey, JSON.stringify(parsed));
                        }
                    }
                } catch(e) {}
            }

            // Re-render
            loadComunidadAnnouncements();
        }

        // -- Load Community Announcements --
        async function loadComunidadAnnouncements() {
            const ok = await waitForFirebase();
            const banner = document.getElementById('comunidadAnnouncements');
            if (!banner) return;

            // Load local cache first to render immediately
            const cacheKey = 'ps_announcements_cache';
            const local = [];
            try {
                const cached = localStorage.getItem(cacheKey);
                if (cached) {
                    const parsed = JSON.parse(cached);
                    if (Array.isArray(parsed)) local.push(...parsed);
                }
            } catch(e) {}

            function renderAnnouncements(items) {
                if (!items || items.length === 0) {
                    banner.style.display = 'none';
                    return;
                }
                banner.style.display = 'block';

                const icons = {
                    general: '📢',
                    update: '⚡',
                    event: '🏆',
                    alert: '⚠️',
                    maintenance: '⚙️'
                };
                
                // Sort by date descending, take top 2
                const sorted = items.sort((a,b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0)).slice(0, 2);

                const uid = currentUser ? currentUser.uid : '';

                banner.innerHTML = `
                    <div class="ann-banner-header">
                        <span>📢 Anuncios de la Comunidad</span>
                        <a href="pages/actualizaciones.html" class="ann-banner-view-all">Ver todos →</a>
                    </div>
                    <div class="ann-banner-grid">
                        ${sorted.map(d => {
                            const icon = icons[d.type] || '📢';
                            const date = d.createdAt ? new Date(d.createdAt).toLocaleDateString('es-CO', {day:'numeric', month:'short'}) : '';
                            const likes = Array.isArray(d.likes) ? d.likes : [];
                            const hasLiked = uid && likes.includes(uid);
                            const likesCount = likes.length;

                            return `
                                <div class="ann-banner-item type-${d.type || 'general'}">
                                    <div class="ann-banner-badge-row" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                                        <div class="ann-banner-badge">
                                            <span>${icon}</span> ${String(d.type || 'general').toUpperCase()}
                                        </div>
                                        <button class="ann-like-btn ${hasLiked ? 'liked' : ''}" data-id="${d.id}" title="${hasLiked ? 'Quitar Me gusta' : 'Dar Me gusta'}" style="background:none; border:none; color:inherit; cursor:pointer; display:flex; align-items:center; gap:4px; font-size:0.8rem; outline:none; transition:transform 0.15s ease;">
                                            <span class="like-heart" style="transition: transform 0.2s ease; display:inline-block; font-size:0.9rem;">${hasLiked ? '❤️' : '🤍'}</span>
                                            <span class="like-count" style="font-weight:700; color:var(--text-secondary);">${likesCount}</span>
                                        </button>
                                    </div>
                                    <h4 class="ann-banner-title">${d.title}</h4>
                                    <p class="ann-banner-body">${d.body}</p>
                                    <div class="ann-banner-meta">Por ${d.createdBy || 'Admin'} · ${date}</div>
                                </div>
                            `;
                        }).join('')}
                    </div>
                `;

                // Bind click delegation for likes only once
                if (!banner.dataset.listenerBound) {
                    banner.addEventListener('click', async (e) => {
                        const likeBtn = e.target.closest('.ann-like-btn');
                        if (!likeBtn) return;
                        e.preventDefault();
                        e.stopPropagation();
                        const annId = likeBtn.dataset.id;
                        if (annId) {
                            likeBtn.style.transform = 'scale(1.25)';
                            setTimeout(() => { likeBtn.style.transform = 'scale(1)'; }, 150);
                            await toggleAnnouncementLike(annId);
                        }
                    });
                    banner.dataset.listenerBound = 'true';
                }
            }

            // Render cached first
            if (local.length > 0) {
                renderAnnouncements(local);
            }

            if (!ok) return;

            // Then fetch live from Firestore
            try {
                const snap = await window.getDocs(window.collection(window.db, 'announcements'));
                const docs = [];
                snap.forEach(doc => {
                    const data = doc.data();
                    let created = data.createdAt;
                    if (created && created.toDate) created = created.toDate().toISOString();
                    docs.push({ id: doc.id, ...data, createdAt: created });
                });

                // Update cache
                localStorage.setItem(cacheKey, JSON.stringify(docs));
                renderAnnouncements(docs);
            } catch(e) {
                console.warn('Error loading live announcements:', e);
            }
        }

        // Run all
        let started = false;
        function startAll() {
            if (started) return;
            started = true;
            console.log('[PanterHub] Inicializando todos los modulos dinámicos con Firebase...');
            loadLeaderboard();
            loadPreregStats();
            loadAccountWidget();
            loadPlayerStats();
            loadComunidadAnnouncements();
            loadDevlogs();
        }

        // Registrar listeners de inicio
        document.addEventListener('firebaseReady', startAll);
        document.addEventListener('DOMContentLoaded', () => {
            // Si Firebase ya cargó antes del DOMContentLoaded
            if (window.auth && window.db && window.collection) {
                startAll();
            }
        });

        // Fallback de seguridad por si no se disparan eventos
        setTimeout(() => {
            if (window.auth && window.db && window.collection) {
                startAll();
            }
        }, 1500);
    })();
    </script>

