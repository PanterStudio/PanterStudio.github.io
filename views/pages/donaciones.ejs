        <script>
            function switchDonationTab(tabId) {
                // Desactivar todos los botones
                document.querySelectorAll('.donation-tab-btn').forEach(btn => {
                    btn.classList.remove('active');
                });
                // Desactivar todos los paneles
                document.querySelectorAll('.donation-panel').forEach(panel => {
                    panel.classList.remove('active');
                });
                
                // Activar seleccionado
                const activeBtn = Array.from(document.querySelectorAll('.donation-tab-btn')).find(btn => btn.getAttribute('onclick').includes(tabId));
                if (activeBtn) activeBtn.classList.add('active');
                
                const activePanel = document.getElementById('panel-' + tabId);
                if (activePanel) activePanel.classList.add('active');
            }

            function toggleQRVisualizer(id) {
                const el = document.getElementById(id);
                if (el) {
                    const isCurrentlyActive = el.classList.contains('active');
                    // Cerrar todos los visualizadores abiertos
                    document.querySelectorAll('.qr-visualizer').forEach(v => v.classList.remove('active'));
                    // Alternar seleccionado
                    if (!isCurrentlyActive) {
                        el.classList.add('active');
                    }
                }
            }

            function copyToClipboard(text, btnElement) {
                navigator.clipboard.writeText(text).then(() => {
                    const originalText = btnElement.textContent;
                    btnElement.textContent = '¡Copiado!';
                    btnElement.style.background = '#00c853';
                    btnElement.style.borderColor = '#00c853';
                    btnElement.style.color = '#fff';
                    setTimeout(() => {
                        btnElement.textContent = originalText;
                        btnElement.style.background = '';
                        btnElement.style.borderColor = '';
                        btnElement.style.color = '';
                    }, 2000);
                }).catch(err => {
                    console.error('Error al copiar:', err);
                });
            }
        </script>
