            <div class="donations-hero-visual hero-visual side-card">
                <div class="donaciones-progress">
                    <div class="progress-track" aria-hidden="true">
                        <div id="donationProgressFill" class="progress-fill" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="--progress:0%;" data-animate="false"></div>
                    </div>
                    <div class="donations-progress-text">
                        <strong id="donationProgressPercent">0%</strong>
                        <span>de la meta</span>
                    </div>
                </div>
                <p class="donations-goal-text">Meta: <strong id="donationGoalAmount">$500</strong> / Recaudado: <strong id="donationCurrentAmount">$0</strong></p>
            </div>
        </section>

         <!-- Centro de Donaciones Interactivo -->
        <style>
            /* Compactación del Hero */
            .donations-hero {
                padding: 1.2rem 1.8rem !important;
                margin-top: 1rem !important;
                min-height: auto !important;
                display: flex !important;
                align-items: center !important;
                justify-content: space-between !important;
                flex-wrap: wrap !important;
                gap: 1.5rem !important;
            }
            .donations-hero-content {
                flex: 1 !important;
                min-width: 280px !important;
            }
            .donations-hero h1 {
                font-size: 1.6rem !important;
                margin: 0.2rem 0 !important;
            }
            .donations-hero p {
                font-size: 0.88rem !important;
                margin: 0 !important;
                opacity: 0.8;
                line-height: 1.4 !important;
            }
            .donations-badge {
                font-size: 0.7rem !important;
                padding: 2px 8px !important;
                margin: 0 !important;
            }
            .donations-hero-visual {
                margin: 0 !important;
                padding: 0.8rem 1.2rem !important;
                max-width: 320px !important;
                width: 100% !important;
                flex-shrink: 0 !important;
            }
            .donaciones-progress {
                margin-bottom: 0.4rem !important;
            }
            .donations-goal-text {
                font-size: 0.8rem !important;
                margin: 0 !important;
                text-align: center;
            }
            
            .donation-center {
                max-width: 980px;
                margin: 1.5rem auto;
                background: rgba(18, 22, 33, 0.85);
                border: 1px solid rgba(0, 176, 255, 0.2);
                border-radius: var(--border-radius-lg);
                padding: 1.8rem;
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                box-shadow: 0 0 30px rgba(0, 176, 255, 0.1), inset 0 0 15px rgba(255, 255, 255, 0.02);
            }
            .donation-tabs {
                display: flex;
                gap: 10px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                padding-bottom: 1rem;
                margin-bottom: 1.5rem;
                overflow-x: auto;
            }
            .donation-tab-btn {
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(255, 255, 255, 0.08);
                color: var(--text-muted);
                padding: 10px 18px;
                border-radius: var(--border-radius);
                cursor: pointer;
                font-weight: 600;
                font-size: 0.9rem;
                white-space: nowrap;
                transition: all 0.3s ease;
            }
            .donation-tab-btn:hover {
                background: rgba(0, 176, 255, 0.08);
                border-color: rgba(0, 176, 255, 0.3);
                color: #00b0ff;
            }
            .donation-tab-btn.active {
                background: #00b0ff;
                border-color: #00b0ff;
                color: #fff;
                box-shadow: 0 0 15px rgba(0, 176, 255, 0.4);
            }
            .donation-panel {
                display: none;
                animation: fadeIn 0.4s ease forwards;
            }
            .donation-panel.active {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 1.5rem;
            }
            .method-card {
                background: rgba(10, 14, 23, 0.5);
                border: 1px solid rgba(255, 255, 255, 0.05);
                border-radius: var(--border-radius);
                padding: 1.5rem;
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
                position: relative;
                overflow: hidden;
                transition: all 0.3s ease;
            }
            .method-card:hover {
                border-color: rgba(0, 176, 255, 0.3);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            }
            .method-icon {
                width: 50px;
                height: 50px;
                object-fit: contain;
                margin-bottom: 0.8rem;
            }
            .method-title {
                font-size: 1.1rem;
                font-weight: 700;
                color: #fff;
                margin-bottom: 0.5rem;
            }
            .method-desc {
                font-size: 0.85rem;
                color: var(--text-muted);
                margin-bottom: 1.2rem;
                line-height: 1.4;
            }
            .method-btn {
                width: 100%;
                background: #00b0ff;
                color: #fff;
                border: none;
                padding: 10px;
                border-radius: var(--border-radius);
                font-weight: 600;
                cursor: pointer;
                text-decoration: none;
                transition: background 0.2s;
            }
            .method-btn:hover {
                background: #0081cb;
            }
            .method-btn.outline {
                background: transparent;
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff;
            }
            .method-btn.outline:hover {
                border-color: #00b0ff;
                background: rgba(0, 176, 255, 0.05);
            }
            /* QR modal / visualizer */
            .qr-visualizer {
                display: none;
                flex-direction: column;
                align-items: center;
                margin-top: 1rem;
                padding-top: 1rem;
                border-top: 1px dashed rgba(255, 255, 255, 0.1);
                width: 100%;
                animation: slideDown 0.3s ease forwards;
            }
            .qr-visualizer.active {
                display: flex;
            }
            .qr-img {
                width: 140px;
                height: 140px;
                background: white;
                padding: 5px;
                border-radius: var(--border-radius);
                margin-bottom: 0.8rem;
                object-fit: contain;
            }
            .copy-field {
                display: flex;
                width: 100%;
                gap: 5px;
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: var(--border-radius);
                padding: 6px 10px;
                font-size: 0.8rem;
                color: #e2e8f0;
                align-items: center;
                justify-content: space-between;
                font-family: monospace;
            }
            .copy-btn {
                background: rgba(0, 176, 255, 0.1);
                border: 1px solid rgba(0, 176, 255, 0.3);
                color: #00b0ff;
                padding: 3px 8px;
                border-radius: 4px;
                cursor: pointer;
                font-size: 0.72rem;
                font-weight: 600;
                transition: all 0.2s;
            }
            .copy-btn:hover {
                background: #00b0ff;
                color: #fff;
            }
            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(5px); }
                to { opacity: 1; transform: translateY(0); }
            }
            @keyframes slideDown {
                from { opacity: 0; transform: translateY(-5px); }
                to { opacity: 1; transform: translateY(0); }
            }
        </style>

