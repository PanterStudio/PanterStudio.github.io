        function filterStore(category) {
            const tabs = document.querySelectorAll('.store-tab');
            tabs.forEach(t => t.classList.remove('active'));
            
            // Highlight clicked tab based on onclick event target context
            const activeTab = Array.from(tabs).find(t => t.outerHTML.includes(`filterStore('${category}')`));
            if (activeTab) activeTab.classList.add('active');

            const cards = document.querySelectorAll('.store-card');
            cards.forEach(c => {
                if (c.dataset.category === 'pet') {
                    c.style.display = 'none';
                    return;
                }
                if (category === 'all' || c.dataset.category === category) {
                    c.style.display = 'flex';
                } else {
                    c.style.display = 'none';
                }
            });
        }

        async function buyStoreItem(itemId, price, itemName) {
            if (!currentUser) return;
            if (userCoins < price) {
                alert(`No tienes suficientes monedas. Necesitas 🪙 ${price.toLocaleString()} y tienes 🪙 ${userCoins.toLocaleString()}.`);
                return;
            }

            if (!confirm(`¿Deseas comprar "${itemName}" por 🪙 ${price.toLocaleString()}?`)) return;

            const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
            try {
                // Read fresh balance
                const docSnap = await window.getDoc(userDocRef);
                if (!docSnap.exists()) return;
                const data = docSnap.data();
                const freshCoins = data.coins || 0;

                if (freshCoins < price) {
                    alert('Saldo desactualizado. No tienes suficientes monedas.');
                    return;
                }

                const newBalance = freshCoins - price;
                const updateFields = { coins: newBalance, updatedAt: new Date().toISOString() };

                // Apply benefits in DB
                if (itemId === 'role_vip') {
                    updateFields.role = 'vip';
                } else if (itemId === 'role_bug_hunter') {
                    updateFields.role = 'bug_hunter';
                } else if (itemId === 'role_moderator') {
                    updateFields.role = 'moderator';
                } else if (itemId === 'role_director_jr') {
                    updateFields.role = 'director_jr';
                } else if (itemId === 'title_coin_king') {
                    updateFields.activeTitle = 'Rey de las Monedas';
                    const currentTitles = Array.isArray(data.titles) ? data.titles : [];
                    if (!currentTitles.includes('Rey de las Monedas')) currentTitles.push('Rey de las Monedas');
                    updateFields.titles = currentTitles;
                } else if (itemId === 'title_master_coder') {
                    updateFields.activeTitle = 'Programador Maestro';
                    const currentTitles = Array.isArray(data.titles) ? data.titles : [];
                    if (!currentTitles.includes('Programador Maestro')) currentTitles.push('Programador Maestro');
                    updateFields.titles = currentTitles;
                } else if (itemId === 'title_magnate') {
                    updateFields.activeTitle = 'Magnate Panter';
                    const currentTitles = Array.isArray(data.titles) ? data.titles : [];
                    if (!currentTitles.includes('Magnate Panter')) currentTitles.push('Magnate Panter');
                    updateFields.titles = currentTitles;
                } else if (itemId === 'title_alfa_legend') {
                    updateFields.activeTitle = 'Leyenda del Alfa';
                    const currentTitles = Array.isArray(data.titles) ? data.titles : [];
                    if (!currentTitles.includes('Leyenda del Alfa')) currentTitles.push('Leyenda del Alfa');
                    updateFields.titles = currentTitles;
                } else if (itemId === 'item_emeralds') {
                    updateFields.esmeraldas = (data.esmeraldas || 0) + 10;
                } else if (itemId === 'item_emeralds_pack') {
                    updateFields.esmeraldas = (data.esmeraldas || 0) + 30;
                } else if (itemId === 'item_risk_insurance') {
                    updateFields.riskInsurance = (data.riskInsurance || 0) + 1;
                    const inventory = data.inventory || {};
                    inventory.risk_insurance = (inventory.risk_insurance || 0) + 1;
                    updateFields.inventory = inventory;
                } else if (itemId === 'item_cooldown_reset') {
                    // Added to inventory instead of instantly resetting
                    const inventory = data.inventory || {};
                    inventory.cooldown_reset = (inventory.cooldown_reset || 0) + 1;
                    updateFields.inventory = inventory;
                } else if (itemId === 'pet_skin_astronaut') {
                    const pet = data.pet || null;
                    if (!pet) {
                        alert('¡Necesitas adoptar una mascota primero en la sección de Mascota!');
                        return;
                    }
                    const unlocked = Array.isArray(pet.unlockedAvatars) ? pet.unlockedAvatars : ['classic'];
                    if (!unlocked.includes('astronaut')) unlocked.push('astronaut');
                    updateFields.pet = { ...pet, unlockedAvatars: unlocked };
                } else if (itemId === 'pet_skin_detective') {
                    const pet = data.pet || null;
                    if (!pet) {
                        alert('¡Necesitas adoptar una mascota primero en la sección de Mascota!');
                        return;
                    }
                    const unlocked = Array.isArray(pet.unlockedAvatars) ? pet.unlockedAvatars : ['classic'];
                    if (!unlocked.includes('detective')) unlocked.push('detective');
                    updateFields.pet = { ...pet, unlockedAvatars: unlocked };
                } else if (itemId === 'pet_skin_golden') {
                    const pet = data.pet || null;
                    if (!pet) {
                        alert('¡Necesitas adoptar una mascota primero en la sección de Mascota!');
                        return;
                    }
                    const unlocked = Array.isArray(pet.unlockedAvatars) ? pet.unlockedAvatars : ['classic'];
                    if (!unlocked.includes('golden')) unlocked.push('golden');
                    updateFields.pet = { ...pet, unlockedAvatars: unlocked };
                } else if (itemId === 'pet_food_steak') {
                    const inventory = data.inventory || {};
                    inventory.steak = (inventory.steak || 0) + 1;
                    updateFields.inventory = inventory;
                } else if (itemId === 'pet_toy_yarn') {
                    const inventory = data.inventory || {};
                    inventory.yarn = (inventory.yarn || 0) + 1;
                    updateFields.inventory = inventory;
                } else if (itemId === 'cosmetic_aura_fire') {
                    updateFields.activeCosmetic = 'aura_fire';
                    const list = Array.isArray(data.purchasedCosmetics) ? data.purchasedCosmetics : [];
                    if (!list.includes('aura_fire')) list.push('aura_fire');
                    updateFields.purchasedCosmetics = list;
                } else if (itemId === 'perk_daily_multiplier') {
                    updateFields.dailyMultiplier = (data.dailyMultiplier || 1.0) + 0.5;
                }

                await window.updateDoc(userDocRef, updateFields);

                // Add to console log
                const feed = document.getElementById('consoleFeed');
                if (feed) {
                    const entry = document.createElement('div');
                    entry.className = 'console-entry';
                    entry.innerHTML = `
                        <span class="entry-label success">▶ TIENDA CORE</span>
                        <div class="entry-body">
                            ¡Compra exitosa! Adquiriste <strong>"${itemName}"</strong>. Se han debitado 🪙 ${price.toLocaleString()} de tu cuenta. Saldo actual: 🪙 ${newBalance.toLocaleString()}.
                        </div>
                    `;
                    feed.appendChild(entry);
                    scrollFeed();
                    saveChatHistory();
                }

                alert(`¡Compra exitosa! Has adquirido "${itemName}".`);
            } catch(e) {
                console.error('Error al realizar compra:', e);
                alert('No se pudo procesar la transacción. Intenta nuevamente.');
            }
        }

        async function useInventoryItem(itemType) {
            if (!currentUser) return;
            const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
            try {
                const docSnap = await window.getDoc(userDocRef);
                if (!docSnap.exists()) return;
                const data = docSnap.data();
                const inventory = data.inventory || {};

                if (itemType === 'cooldown_reset') {
                    const count = inventory.cooldown_reset || 0;
                    if (count <= 0) {
                        alert('No tienes Pociones de Cooldown en tu inventario.');
                        return;
                    }
                    if (!confirm('¿Seguro que deseas consumir 1 Poción de Cooldown para resetear tus enfriamientos?')) return;

                    inventory.cooldown_reset = count - 1;
                    const updateFields = {
                        inventory: inventory,
                        cooldownWork: 0,
                        cooldownRisk: 0,
                        updatedAt: new Date().toISOString()
                    };

                    await window.updateDoc(userDocRef, updateFields);

                    // Sync local countdowns
                    cooldowns.work = 0;
                    cooldowns.risk = 0;
                    localStorage.removeItem('panterAI_cooldown_work');
                    localStorage.removeItem('panterAI_cooldown_risk');

                    const feed = document.getElementById('consoleFeed');
                    if (feed) {
                        const entry = document.createElement('div');
                        entry.className = 'console-entry';
                        entry.innerHTML = `
                            <span class="entry-label warning">▶ INVENTARIO</span>
                            <div class="entry-body">
                                Consumiste 1 <strong>Pocion de Cooldown</strong>. Enfriamientos reseteados exitosamente.
                            </div>
                        `;
                        feed.appendChild(entry);
                        scrollFeed();
                        saveChatHistory();
                    }

                    alert('¡Pocion de Cooldown consumida exitosamente!');
                }
            } catch(e) {
                console.error('Error al usar objeto:', e);
                alert('No se pudo consumir el objeto. Intenta nuevamente.');
            }
        }

        async function initAIGame() {
            await waitForFirebase();
            
            // Cargar historial de chat si existe en caché
            const savedChat = localStorage.getItem('panterAI_chat_history');
            if (savedChat) {
                document.getElementById('consoleFeed').innerHTML = savedChat;
                scrollFeed();
            }

            window.auth.onAuthStateChanged(async (user) => {
                if (user) {
                    currentUser = user;
                    document.getElementById('authNotice').style.display = 'none';
                    document.getElementById('coreDashboard').style.display = 'grid';
                    
                    // Do NOT show terminal/store automatically on login, wait for card click
                    document.getElementById('gameContainer').style.display = 'none';
                    document.getElementById('storeContainer').style.display = 'none';
                    if (document.getElementById('inventoryContainer')) {
                        document.getElementById('inventoryContainer').style.display = 'none';
                    }
                    if (document.getElementById('btnDashTerminal')) document.getElementById('btnDashTerminal').classList.remove('active');
                    if (document.getElementById('btnDashStore')) document.getElementById('btnDashStore').classList.remove('active');
                    if (document.getElementById('btnDashInventory')) document.getElementById('btnDashInventory').classList.remove('active');
                    
                    const userDocRef = window.fsDoc(window.db, 'conductores', user.uid);
                    window.onSnapshot(userDocRef, (snap) => {
                        if (snap.exists()) {
                            const data = snap.data();
                            userCoins = data.coins || 0;
                            const cd = document.getElementById('coinDisplay');
                            if (cd) cd.textContent = Number(userCoins).toLocaleString();
                            // Sincronizar cooldowns desde DB
                            if (data.cooldownWork) {
                                cooldowns.work = Math.max(cooldowns.work, Number(data.cooldownWork) || 0);
                            }
                            if (data.cooldownRisk) {
                                cooldowns.risk = Math.max(cooldowns.risk, Number(data.cooldownRisk) || 0);
                            }

                            // Sincronizar inventario en la UI
                            const inventory = data.inventory || {};
                            const countCooldown = inventory.cooldown_reset || 0;
                            const countInsurance = data.riskInsurance || inventory.risk_insurance || 0;
                            const countEmeralds = data.esmeraldas || 0;

                            const elCooldown = document.getElementById('invCountCooldown');
                            if (elCooldown) elCooldown.textContent = countCooldown;

                            const elInsurance = document.getElementById('invCountInsurance');
                            if (elInsurance) elInsurance.textContent = countInsurance;

                            const elEmeralds = document.getElementById('invCountEmeralds');
                            if (elEmeralds) elEmeralds.textContent = countEmeralds;

                            const btnUseCooldown = document.getElementById('btnUseCooldown');
                            if (btnUseCooldown) {
                                if (countCooldown <= 0) {
                                    btnUseCooldown.disabled = true;
                                    btnUseCooldown.style.opacity = '0.5';
                                    btnUseCooldown.style.cursor = 'not-allowed';
                                } else {
                                    btnUseCooldown.disabled = false;
                                    btnUseCooldown.style.opacity = '1';
                                    btnUseCooldown.style.cursor = 'pointer';
                                }
                            }
                            
                            // Mascot snapshot sync
                            if (data.pet) {
                                currentPetData = data.pet;
                                const petBox = document.getElementById('petContainer');
                                if (petBox && petBox.style.display !== 'none') {
                                    updatePetUI();
                                }
                            } else {
                                currentPetData = null;
                            }
                        }
                    });
                } else {
                    document.getElementById('authNotice').style.display = 'flex';
                    document.getElementById('coreDashboard').style.display = 'none';
                    document.getElementById('gameContainer').style.display = 'none';
                    document.getElementById('storeContainer').style.display = 'none';
                    if (document.getElementById('inventoryContainer')) {
                        document.getElementById('inventoryContainer').style.display = 'none';
                    }
                }
            });
        }

        function scrollFeed() {
            const feed = document.getElementById('consoleFeed');
            feed.scrollTop = feed.scrollHeight;
        }

        function saveChatHistory() {
            const feed = document.getElementById('consoleFeed');
            localStorage.setItem('panterAI_chat_history', feed.innerHTML);
        }

        function setCoreState(state) {
            const orb = document.getElementById('aiCoreOrb');
            const label = document.getElementById('aiStatusLabel');
            const loader = document.getElementById('aiLoader');
            
            // Remove classes
            orb.classList.remove('thinking', 'success', 'error');
            loader.style.display = 'none';

            if (state === 'thinking') {
                orb.classList.add('thinking');
                label.textContent = 'PROCESANDO...';
                label.style.color = '#fbbf24';
                loader.style.display = 'flex';
            } else if (state === 'success') {
                orb.classList.add('success');
                label.textContent = '¡COMPLETADO!';
                label.style.color = '#00c853';
            } else if (state === 'error') {
                orb.classList.add('error');
                label.textContent = 'MISIÓN FALLIDA / ESPERA';
                label.style.color = '#ef4444';
            } else {
                label.textContent = 'SISTEMA LISTO';
                label.style.color = '#00b0ff';
            }
            scrollFeed();
        }

        function logCommand(cmdText) {
            const feed = document.getElementById('consoleFeed');
            const html = `
                <div class="console-entry">
                    <span class="entry-label user">&gt; ACCIÓN: /${cmdText.toUpperCase()}</span>
                    <div class="entry-body user">Iniciando...</div>
                </div>
            `;
            feed.insertAdjacentHTML('beforeend', html);
            scrollFeed();
            saveChatHistory();
        }

        function formatMarkdown(text) {
            return String(text)
                .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                .replace(/\*([^*]+)\*/g, '<em>$1</em>')
                .replace(/\*/g, ''); // Limpiar asteriscos huérfanos
        }

        function logAIResponse(title, text) {
            const feed = document.getElementById('consoleFeed');
            const cleanText = formatMarkdown(text);
            const html = `
                <div class="console-entry">
                    <span class="entry-label ai">[PANTER AI]: ${title.toUpperCase()}</span>
                    <div class="entry-body">${cleanText}</div>
                </div>
            `;
            feed.insertAdjacentHTML('beforeend', html);
            scrollFeed();
            saveChatHistory();
        }

        // 💼 TRABAJAR (SEGURO - NUEVOS MINIJUEGOS ARCADE)
        let activeJobTimer = null;
        let activeJobScore = 0;
        let activeJobActive = false;
        let activeJobType = 0; // 0: Road Racer, 1: Fuel Tapper, 2: Cargo Sorter

        // Estado del juego 0 (Road Racer)
        let truckLane = 1; // 0: Izq, 1: Centro, 2: Der
        let obstacleGrid = [
            [false, false, false],
            [false, false, false],
            [false, false, false]
        ];

        // Estado del juego 1 (Fuel Tapper)
        let fuelIndicatorX = 0;
        let fuelDir = 1;

        // Estado del juego 2 (Cargo Sorter)
        let conveyorY = 0;
        const cargoItems = [
            { emoji: '🍏', category: 'alimento' },
            { emoji: '🍌', category: 'alimento' },
            { emoji: '💻', category: 'tecnologia' },
            { emoji: '🔌', category: 'tecnologia' },
            { emoji: '💎', category: 'mineria' },
            { emoji: '👑', category: 'mineria' }
        ];
        let currentCargoItem = null;

        const WORK_COOLDOWN_MS  = 7  * 60 * 1000; // 7 minutos
        const RISK_COOLDOWN_MS  = 10 * 60 * 1000; // 10 minutos

        function formatCooldown(ms) {
            const totalSec = Math.ceil(ms / 1000);
            const m = Math.floor(totalSec / 60);
            const s = totalSec % 60;
            return m > 0 ? `${m}m ${s}s` : `${s}s`;
        }

        async function executeWork() {
            // ── Verificar cooldown ──
            const remaining = cooldowns.work - Date.now();
            if (remaining > 0) {
                logCommand('trabajar');
                setCoreState('error');
                logAIResponse('⏳ En Espera', `Ya trabajaste recientemente. Podrás volver a trabajar en **${formatCooldown(remaining)}**.`);
                return;
            }

            logCommand('trabajar');
            setCoreState('thinking');

            // ── Registrar cooldown preventivo (7 min desde ahora) ──
            const targetCooldown = Date.now() + WORK_COOLDOWN_MS;
            cooldowns.work = targetCooldown;
            localStorage.setItem('panterAI_cooldown_work', targetCooldown);
            
            try {
                const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                await window.setDoc(userDocRef, { 
                    cooldownWork: targetCooldown,
                    updatedAt: new Date().toISOString() 
                }, { merge: true });
            } catch (err) {
                console.warn("Fallo al registrar cooldown preventivo:", err);
            }

            document.getElementById('consoleFeed').style.display = 'none';
            const screen = document.getElementById('casinoVisualScreen');
            screen.style.display = 'flex';

            activeJobScore = 0;
            activeJobActive = true;
            activeJobType = Math.floor(Math.random() * 3);

            if (activeJobType === 0) {
                // 1. Road Racer (Evitar obstáculos)
                truckLane = 1;
                obstacleGrid = [
                    [false, false, false],
                    [false, false, false],
                    [false, false, false]
                ];
                screen.innerHTML = `
                    <div class="work-game-container" style="width: 100%;">
                        <div class="casino-title">🚚 EVITA OBSTACULOS EN CARRETERA</div>
                        <p style="font-size:0.8rem; color:var(--text-secondary); text-align:center; margin:0 0 10px 0;">¡Esquiva los obstaculos (🚧) usando los botones!</p>
                        
                        <div style="width:180px; height:150px; background:#111827; margin:0 auto 10px auto; border:2px solid #4b5563; border-radius:8px; display:grid; grid-template-rows: repeat(3, 1fr); padding:5px; box-sizing:border-box; position:relative;" id="roadGrid">
                        </div>
                        
                        <div style="display:flex; gap:10px; justify-content:center; margin-bottom:10px; width:100%;">
                            <button class="cyber-chip" onclick="moveTruck(-1)">◀ Izq</button>
                            <button class="cyber-chip" onclick="moveTruck(1)">Der ▶</button>
                        </div>
                        
                        <div class="work-progress-bar">
                            <div class="work-progress-fill" id="workProgressBarFill" style="width: 100%;"></div>
                        </div>
                        <div style="font-weight: bold; color: #ffd700;" id="workScore">Ruta Completada: 0% (+$0 🪙)</div>
                    </div>
                `;
                drawRoadGrid();
            } else if (activeJobType === 1) {
                // 2. Fuel Tapper (Recarga Precisa)
                fuelIndicatorX = 0;
                fuelDir = 1;
                screen.innerHTML = `
                    <div class="work-game-container" style="width: 100%;">
                        <div class="casino-title">⛽ RECARGA PRECISA DE COMBUSTIBLE</div>
                        <p style="font-size:0.8rem; color:var(--text-secondary); text-align:center; margin:0 0 10px 0;">¡Presiona RECARGAR cuando el indicador este en la zona verde!</p>
                        
                        <div style="width:100%; max-width:240px; height:30px; background:#1f2937; border-radius:15px; position:relative; overflow:hidden; border:2px solid #4b5563; margin:15px auto;">
                            <div style="position:absolute; left:40%; width:20%; height:100%; background:rgba(16,185,129,0.4); border-left:2px solid #10b981; border-right:2px solid #10b981;"></div>
                            <div id="fuelIndicator" style="position:absolute; top:0; bottom:0; left:0%; width:8px; background:#ffffff; box-shadow:0 0 8px #fff; border-radius:4px; transform:translateX(-50%);"></div>
                        </div>
                        
                        <div style="display:flex; justify-content:center; margin-bottom:15px; width:100%;">
                            <button class="cyber-chip" style="background:#10b981; width:140px;" onclick="tappedRefuel()">⛽ RECARGAR</button>
                        </div>
                        
                        <div class="work-progress-bar">
                            <div class="work-progress-fill" id="workProgressBarFill" style="width: 100%;"></div>
                        </div>
                        <div style="font-weight: bold; color: #ffd700;" id="workScore">Cargas Exitosas: 0 / 5 (+$0 🪙)</div>
                    </div>
                `;
            } else {
                // 3. Cargo Sorter (Clasificador de Mercancía)
                conveyorY = 0;
                currentCargoItem = cargoItems[Math.floor(Math.random() * cargoItems.length)];
                screen.innerHTML = `
                    <div class="work-game-container" style="width: 100%;">
                        <div class="casino-title">📦 CLASIFICADOR DE MERCANCIA</div>
                        <p style="font-size:0.8rem; color:var(--text-secondary); text-align:center; margin:0 0 10px 0;">¡Clasifica el articulo presionando su contenedor correcto!</p>
                        
                        <div style="width:200px; height:130px; background:#111827; border:2px solid #4b5563; border-radius:8px; margin:0 auto 10px auto; position:relative; overflow:hidden;" id="conveyorBelt">
                            <div id="cargoItemEl" style="position:absolute; left:50%; top:0%; font-size:2.2rem; transform:translateX(-50%); transition:top 0.1s linear;">🍏</div>
                        </div>
                        
                        <div style="display:flex; gap:6px; justify-content:center; margin-bottom:15px; width:100%;">
                            <button class="cyber-chip" style="font-size:0.8rem; padding:8px;" onclick="classifyCargo('alimento')">🍏 Alimento</button>
                            <button class="cyber-chip" style="font-size:0.8rem; padding:8px;" onclick="classifyCargo('tecnologia')">💻 Tecno</button>
                            <button class="cyber-chip" style="font-size:0.8rem; padding:8px;" onclick="classifyCargo('mineria')">💎 Minero</button>
                        </div>
                        
                        <div class="work-progress-bar">
                            <div class="work-progress-fill" id="workProgressBarFill" style="width: 100%;"></div>
                        </div>
                        <div style="font-weight: bold; color: #ffd700;" id="workScore">Clasificados: 0 / 5 (+$0 🪙)</div>
                    </div>
                `;
                updateConveyorItem();
            }

            const startTime = Date.now();
            const duration = 6000;
            const progressFill = document.getElementById('workProgressBarFill');

            try {
                initAudio();
            } catch(e){}

            let tickCount = 0;

            activeJobTimer = setInterval(async () => {
                const elapsed = Date.now() - startTime;
                const remaining = Math.max(0, duration - elapsed);
                const percent = (remaining / duration) * 100;
                
                if (progressFill) progressFill.style.width = percent + '%';

                // Ticks específicos de cada minijuego
                if (activeJobActive) {
                    if (activeJobType === 0) {
                        // Road Racer tick cada 500ms
                        tickCount++;
                        if (tickCount % 5 === 0) {
                            // Mover obstáculos abajo
                            obstacleGrid[2] = [...obstacleGrid[1]];
                            obstacleGrid[1] = [...obstacleGrid[0]];
                            obstacleGrid[0] = [false, false, false];
                            
                            // Spawn nuevo obstáculo (50% prob)
                            if (Math.random() < 0.5) {
                                obstacleGrid[0][Math.floor(Math.random() * 3)] = true;
                            }
                            
                            // Verificar colisión
                            if (obstacleGrid[2][truckLane]) {
                                try {
                                    playTickSound();
                                } catch(e){}
                                activeJobActive = false;
                                clearInterval(activeJobTimer);
                                drawRoadGrid();
                                const scoreLabel = document.getElementById('workScore');
                                if (scoreLabel) {
                                    scoreLabel.innerHTML = `💥 ¡CHOQUE! Ruta fallida (+$${Math.floor(activeJobScore)} 🪙)`;
                                    scoreLabel.style.color = '#ef4444';
                                }
                                setTimeout(async () => {
                                    await finishActiveJob();
                                }, 1500);
                                return;
                            }
                            
                            // Sumar puntos por sobrevivir
                            activeJobScore += 4.2; 
                            const scoreLabel = document.getElementById('workScore');
                            const routePercent = Math.min(100, Math.floor(activeJobScore * 2));
                            const earn = Math.min(50, Math.floor(activeJobScore));
                            if (scoreLabel) {
                                scoreLabel.innerHTML = `Ruta Completada: ${routePercent}% (+$${earn} 🪙)`;
                            }
                            drawRoadGrid();
                        }
                    } else if (activeJobType === 1) {
                        // Fuel Tapper indicator movement
                        fuelIndicatorX += fuelDir * 6;
                        if (fuelIndicatorX >= 100 || fuelIndicatorX <= 0) fuelDir *= -1;
                        const indicator = document.getElementById('fuelIndicator');
                        if (indicator) indicator.style.left = fuelIndicatorX + '%';
                    } else if (activeJobType === 2) {
                        // Cargo Sorter conveyor movement
                        conveyorY += 4;
                        const itemEl = document.getElementById('cargoItemEl');
                        if (itemEl) itemEl.style.top = conveyorY + '%';
                        
                        if (conveyorY >= 100) {
                            // Falló en clasificar a tiempo
                            conveyorY = 0;
                            currentCargoItem = cargoItems[Math.floor(Math.random() * cargoItems.length)];
                            updateConveyorItem();
                        }
                    }
                }

                if (remaining <= 0) {
                    clearInterval(activeJobTimer);
                    activeJobActive = false;
                    await finishActiveJob();
                }
            }, 100);
        }

        // Helpers de Road Racer
        function drawRoadGrid() {
            const grid = document.getElementById('roadGrid');
            if (!grid) return;
            
            grid.innerHTML = '';
            for (let r = 0; r < 3; r++) {
                const rowEl = document.createElement('div');
                rowEl.style.display = 'grid';
                rowEl.style.gridTemplateColumns = 'repeat(3, 1fr)';
                rowEl.style.width = '100%';
                rowEl.style.height = '100%';
                
                for (let c = 0; c < 3; c++) {
                    const colEl = document.createElement('div');
                    colEl.style.border = '1px dashed rgba(255,255,255,0.05)';
                    colEl.style.display = 'flex';
                    colEl.style.alignItems = 'center';
                    colEl.style.justifyContent = 'center';
                    colEl.style.fontSize = '1.3rem';
                    
                    if (r === 2 && c === truckLane) {
                        colEl.innerText = obstacleGrid[2][c] ? '💥' : '🚚';
                    } else if (obstacleGrid[r][c]) {
                        colEl.innerText = '🚧';
                    }
                    rowEl.appendChild(colEl);
                }
                grid.appendChild(rowEl);
            }
        }

        function moveTruck(dir) {
            if (!activeJobActive || activeJobType !== 0) return;
            truckLane = Math.max(0, Math.min(2, truckLane + dir));
            try {
                playTickSound();
            } catch(e){}
            
            // Colisión inmediata al mover
            if (obstacleGrid[2][truckLane]) {
                activeJobActive = false;
                clearInterval(activeJobTimer);
                drawRoadGrid();
                const scoreLabel = document.getElementById('workScore');
                if (scoreLabel) {
                    scoreLabel.innerHTML = `💥 ¡CHOQUE! Ruta fallida (+$${Math.floor(activeJobScore)} 🪙)`;
                    scoreLabel.style.color = '#ef4444';
                }
                setTimeout(async () => {
                    await finishActiveJob();
                }, 1500);
            } else {
                drawRoadGrid();
            }
        }

        // Helpers de Fuel Tapper
        function tappedRefuel() {
            if (!activeJobActive || activeJobType !== 1) return;
            try {
                playTickSound();
            } catch(e){}
            
            const scoreLabel = document.getElementById('workScore');
            
            if (fuelIndicatorX >= 40 && fuelIndicatorX <= 60) {
                // Éxito
                activeJobScore++;
                if (scoreLabel) {
                    scoreLabel.innerHTML = `Cargas Exitosas: ${activeJobScore} / 5 (+$${activeJobScore * 10} 🪙)`;
                    scoreLabel.style.color = '#00c853';
                    setTimeout(() => { if (scoreLabel) scoreLabel.style.color = '#ffd700'; }, 300);
                }
                if (activeJobScore >= 5) {
                    clearInterval(activeJobTimer);
                    activeJobActive = false;
                    finishActiveJob();
                }
            } else {
                // Fallo
                if (scoreLabel) {
                    scoreLabel.style.color = '#ef4444';
                    setTimeout(() => { if (scoreLabel) scoreLabel.style.color = '#ffd700'; }, 300);
                }
            }
        }

        // Helpers de Cargo Sorter
        function updateConveyorItem() {
            const el = document.getElementById('cargoItemEl');
            if (el && currentCargoItem) {
                el.innerText = currentCargoItem.emoji;
                el.style.top = '0%';
            }
        }

        function classifyCargo(category) {
            if (!activeJobActive || activeJobType !== 2 || !currentCargoItem) return;
            try {
                playTickSound();
            } catch(e){}

            const scoreLabel = document.getElementById('workScore');

            if (category === currentCargoItem.category) {
                activeJobScore++;
                if (scoreLabel) {
                    scoreLabel.innerHTML = `Clasificados: ${activeJobScore} / 5 (+$${activeJobScore * 10} 🪙)`;
                    scoreLabel.style.color = '#00c853';
                    setTimeout(() => { if (scoreLabel) scoreLabel.style.color = '#ffd700'; }, 300);
                }
                if (activeJobScore >= 5) {
                    clearInterval(activeJobTimer);
                    activeJobActive = false;
                    finishActiveJob();
                }
            } else {
                if (scoreLabel) {
                    scoreLabel.style.color = '#ef4444';
                    setTimeout(() => { if (scoreLabel) scoreLabel.style.color = '#ffd700'; }, 300);
                }
            }

            conveyorY = 0;
            currentCargoItem = cargoItems[Math.floor(Math.random() * cargoItems.length)];
            updateConveyorItem();
        }

        async function finishActiveJob() {
            const screen = document.getElementById('casinoVisualScreen');
            const scoreLabel = document.getElementById('workScore');
            
            let earn = 0;
            let title = 'Trabajo';
            let desc = '';

            if (activeJobType === 0) {
                earn = Math.min(50, Math.floor(activeJobScore));
                title = 'Ruta Carretera';
                desc = `Esquivaste los obstaculos y completaste parte del trayecto.`;
            } else if (activeJobType === 1) {
                earn = Math.min(50, activeJobScore * 10);
                title = 'Recarga de Combustible';
                desc = `Realizaste ${activeJobScore} recargas precisas de combustible.`;
            } else {
                earn = Math.min(50, activeJobScore * 10);
                title = 'Clasificador de Mercancia';
                desc = `Clasificaste correctamente ${activeJobScore} paquetes de carga.`;
            }

            const newCoins = (Number(userCoins) || 0) + earn;

            if (scoreLabel) {
                scoreLabel.innerHTML = `¡TIEMPO AGOTADO! Resultado: +$${earn} 🪙`;
                scoreLabel.style.color = '#00c853';
            }

            try {
                const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                await window.setDoc(userDocRef, { 
                    coins: newCoins, 
                    updatedAt: new Date().toISOString() 
                }, { merge: true });
                
                try {
                    await window.addDoc(window.collection(window.db, 'conductores', currentUser.uid, 'activity'), {
                        type: 'work',
                        description: `${title} (+${earn} 🪙)`,
                        coins: earn,
                        createdAt: new Date().toISOString()
                    });
                } catch (e) {
                    console.warn("Actividad no registrada:", e);
                }

                setCoreState('success');
                logAIResponse('Trabajo Terminado', `${desc} ¡Recibes **+$${earn} monedas**! Saldo: **$${newCoins} 🪙**.`);
            } catch (err) {
                console.error(err);
                setCoreState('error');
                logAIResponse('Falla del Sistema', `No se pudo guardar el progreso. Detalle: ${err.message}`);
            }

            setTimeout(() => {
                resetControls();
            }, 2500);
        }


        // 🚨 MISION DE RIESGO (CRIMEN - MULTIPLES MINIJUEGOS)
        let activeRiskTimer = null;
        let activeRiskActive = false;
        let activeRiskType = 0; // 0: Bypass de Red, 1: Desactivar Alarma, 2: Conectar Cables
        let riskHackedCount = 0;
        let riskActiveNodeIdx = -1;
        let riskFirewallNodes = []; // Guardar indices de los 3 firewalls
        
        let targetPin = '';
        let currentPinInput = '';

        let selectedLeftPort = null;
        let connectedWires = 0;

        async function executeRisk() {
            // ── Verificar cooldown ──
            const remaining = cooldowns.risk - Date.now();
            if (remaining > 0) {
                logCommand('mision_riesgo');
                setCoreState('error');
                logAIResponse('⏳ En Espera', `Ya realizaste una misión recientemente. Podrás intentarlo de nuevo en **${formatCooldown(remaining)}**.`);
                return;
            }

            logCommand('mision_riesgo');
            setCoreState('thinking');
            
            // ── Registrar cooldown preventivo (10 min desde ahora) ──
            const targetCooldown = Date.now() + RISK_COOLDOWN_MS;
            cooldowns.risk = targetCooldown;
            localStorage.setItem('panterAI_cooldown_risk', targetCooldown);

            try {
                const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                await window.setDoc(userDocRef, { 
                    cooldownRisk: targetCooldown,
                    updatedAt: new Date().toISOString() 
                }, { merge: true });
            } catch (err) {
                console.warn("Fallo al registrar cooldown preventivo:", err);
            }

            document.getElementById('consoleFeed').style.display = 'none';
            const screen = document.getElementById('casinoVisualScreen');
            screen.style.display = 'flex';

            riskHackedCount = 0;
            activeRiskActive = true;
            activeRiskType = Math.floor(Math.random() * 3);

