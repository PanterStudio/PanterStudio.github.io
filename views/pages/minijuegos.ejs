<%- include('partials/header', { 
    title: 'Panter Core — Panter Studio', 
    currentPage: 'minijuegos',
    description: undefined,
    extraHead: `<style>
        /* ══════════════════════════════════════════
           PANTER CORE — AI MODULE EPIC DESIGN
        ══════════════════════════════════════════ */
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@700;900&display=swap');

        /* ─── HERO BANNER ─── */
        .ai-module-hero {
            text-align: center;
            padding: 3rem 1rem 1.5rem;
            position: relative;
            overflow: hidden;
        }
        .ai-module-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0,176,255,0.18) 0%, transparent 70%),
                radial-gradient(ellipse 40% 50% at 10% 80%, rgba(88,101,242,0.1) 0%, transparent 60%);
            pointer-events: none;
        }
        .ai-hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            color: #00b0ff;
            background: rgba(0,176,255,0.08);
            border: 1px solid rgba(0,176,255,0.25);
            border-radius: 100px;
            padding: 0.28rem 0.85rem;
            margin-bottom: 1rem;
        }
        .ai-hero-eyebrow-dot {
            width: 6px; height: 6px;
            background: #00c853;
            border-radius: 50%;
            animation: aiDotBlink 1.4s ease-in-out infinite;
        }
        @keyframes aiDotBlink {
            0%,100%{opacity:1;} 50%{opacity:0.2;}
        }
        .ai-module-hero h1 {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(1.8rem, 5vw, 2.8rem);
            font-weight: 900;
            line-height: 1.1;
            margin: 0 0 0.6rem;
            background: linear-gradient(135deg, #fff 0%, #00b0ff 50%, #5865f2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .ai-module-hero p {
            color: var(--text-muted);
            font-size: clamp(0.85rem, 2.5vw, 1rem);
            max-width: 500px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* ─── MAIN TERMINAL CONTAINER ─── */
        .ai-terminal-container {
            max-width: 900px;
            margin: 0 auto 2rem;
            background: rgba(10, 13, 24, 0.92);
            border: 1px solid rgba(0, 176, 255, 0.18);
            border-radius: 24px;
            box-shadow:
                0 0 0 1px rgba(255,255,255,0.04),
                0 0 60px rgba(0, 176, 255, 0.1),
                0 20px 60px rgba(0,0,0,0.6);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        /* ─── HEADER PANEL ─── */
        .ai-header-panel {
            padding: 2.2rem 1.5rem 1.8rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.6rem;
            position: relative;
            background: linear-gradient(180deg, rgba(0,176,255,0.06) 0%, transparent 100%);
            border-bottom: 1px solid rgba(0,176,255,0.1);
            overflow: hidden;
        }
        /* Scanline overlay */
        .ai-header-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                rgba(0,176,255,0.015) 2px,
                rgba(0,176,255,0.015) 4px
            );
            pointer-events: none;
        }
        /* Corner accent lines */
        .ai-header-panel::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, #00b0ff, transparent);
            animation: scanLine 3s ease-in-out infinite;
        }
        @keyframes scanLine {
            0%,100%{ opacity:0.4; } 50%{ opacity:1; }
        }

        /* ─── AI CORE ORB — Multi-ring ─── */
        .ai-orb-wrapper {
            position: relative;
            width: 120px;
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .ai-orb-ring {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(0,176,255,0.2);
        }
        .ai-orb-ring:nth-child(1) { width:120px; height:120px; animation: spinRing 20s linear infinite; border-style: dashed; }
        .ai-orb-ring:nth-child(2) { width:105px; height:105px; animation: spinRing 8s linear infinite reverse; border-color: rgba(0,176,255,0.35); }
        .ai-orb-ring:nth-child(3) { width: 90px; height: 90px; animation: spinRing 5s linear infinite; border-color: rgba(0,176,255,0.15); border-style: dashed; }
        .ai-core-orb {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, rgba(0,240,255,0.5) 0%, rgba(0,100,180,0.3) 50%, transparent 80%);
            border: 2px solid rgba(0,176,255,0.9);
            box-shadow:
                0 0 20px rgba(0,176,255,0.8),
                0 0 50px rgba(0,176,255,0.3),
                inset 0 0 20px rgba(0,176,255,0.4);
            position: relative;
            transition: all 0.5s ease;
            animation: orbBreathe 2.5s ease-in-out infinite alternate;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
        }
        .ai-core-orb::after {
            content: '';
            position: absolute;
            inset: 4px;
            border-radius: 50%;
            border: 1.5px solid rgba(255,255,255,0.15);
            border-top-color: rgba(0,240,255,0.8);
            animation: spinRing 2s linear infinite;
        }

        /* Orb states */
        .ai-core-orb.thinking {
            border-color: #fbbf24;
            background: radial-gradient(circle at 35% 35%, rgba(255,200,50,0.5) 0%, rgba(180,100,0,0.3) 60%, transparent 80%);
            box-shadow: 0 0 25px rgba(251,191,36,0.8), 0 0 60px rgba(251,191,36,0.25), inset 0 0 20px rgba(251,191,36,0.4);
        }
        .ai-core-orb.thinking::after { border-top-color: #fbbf24; }
        .ai-core-orb.success {
            border-color: #00c853;
            background: radial-gradient(circle at 35% 35%, rgba(0,240,100,0.5) 0%, rgba(0,120,50,0.3) 60%, transparent 80%);
            box-shadow: 0 0 25px rgba(0,200,83,0.8), 0 0 60px rgba(0,200,83,0.25), inset 0 0 20px rgba(0,200,83,0.4);
        }
        .ai-core-orb.success::after { border-top-color: #00c853; }
        .ai-core-orb.error {
            border-color: #ef4444;
            background: radial-gradient(circle at 35% 35%, rgba(255,60,60,0.5) 0%, rgba(180,0,0,0.3) 60%, transparent 80%);
            box-shadow: 0 0 25px rgba(239,68,68,0.8), 0 0 60px rgba(239,68,68,0.25), inset 0 0 20px rgba(239,68,68,0.4);
        }
        .ai-core-orb.error::after { border-top-color: #ef4444; }

        @keyframes orbBreathe {
            from { transform: scale(0.95); }
            to   { transform: scale(1.05); }
        }
        @keyframes spinRing {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        /* Status text + coin bar */
        .ai-status-text {
            margin-top: 2px;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: #00b0ff;
            font-weight: 800;
            text-shadow: 0 0 12px rgba(0,176,255,0.6);
            transition: color 0.3s;
        }
        .ai-coin-bar {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(0,176,255,0.06);
            border: 1px solid rgba(0,176,255,0.15);
            border-radius: 100px;
            padding: 0.3rem 1rem;
            font-size: 0.8rem;
            font-weight: 700;
            color: #fff;
            margin-top: 0.25rem;
        }
        .ai-coin-bar span { color: #fbbf24; font-size: 0.85rem; }

        /* ─── CONSOLE FEED ─── */
        .ai-console-feed {
            flex-grow: 1;
            padding: 1.5rem;
            min-height: 280px;
            max-height: 380px;
            overflow-y: auto;
            background:
                linear-gradient(180deg, rgba(5,8,18,0.0) 0%, rgba(5,8,18,0.6) 100%),
                rgba(5, 8, 18, 0.8);
            border-bottom: 1px solid rgba(0,176,255,0.08);
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
            scrollbar-width: thin;
            scrollbar-color: rgba(0,176,255,0.3) transparent;
        }
        .ai-console-feed::-webkit-scrollbar { width: 4px; }
        .ai-console-feed::-webkit-scrollbar-track { background: transparent; }
        .ai-console-feed::-webkit-scrollbar-thumb { background: rgba(0,176,255,0.3); border-radius: 4px; }

        .console-entry {
            display: flex;
            flex-direction: column;
            gap: 4px;
            animation: entryFade 0.35s cubic-bezier(0.16,1,0.3,1) forwards;
        }
        @keyframes entryFade {
            from { opacity:0; transform: translateY(12px); }
            to   { opacity:1; transform: translateY(0); }
        }
        .entry-label {
            font-size: 0.68rem;
            font-weight: 800;
            color: var(--text-muted);
            letter-spacing: 0.06em;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }
        .entry-label.user { color: #00b0ff; }
        .entry-label.ai   { color: #00c853; }
        .entry-body {
            font-size: 0.92rem;
            color: #e2e8f0;
            line-height: 1.55;
            background: rgba(255,255,255,0.025);
            padding: 10px 14px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
            display: inline-block;
            max-width: 92%;
        }
        .entry-body.user {
            background: rgba(0,176,255,0.05);
            border-color: rgba(0,176,255,0.14);
        }

        /* ─── CONTROL BOARD ─── */
        .ai-control-board {
            padding: 1.4rem;
            background: rgba(8,11,22,0.95);
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
            border-top: 1px solid rgba(0,176,255,0.08);
        }
        .board-section-label {
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: rgba(0,176,255,0.5);
            padding: 0 0.2rem;
        }
        .board-buttons-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
        @media (max-width: 500px) {
            .board-buttons-grid { 
                grid-template-columns: repeat(2, 1fr) !important; 
                gap: 8px !important;
            }
            .cyber-chip {
                padding: 0.6rem 0.5rem !important;
                font-size: 0.75rem !important;
                gap: 6px !important;
                flex-direction: column !important;
                text-align: center !important;
                border-radius: 10px !important;
            }
            .chip-icon {
                width: 24px !important;
                height: 24px !important;
            }
            .chip-text small {
                font-size: 0.55rem !important;
                display: block !important;
                margin-top: 1px !important;
            }
        }

        /* ─── ACTION CHIPS (card style) ─── */
        .cyber-chip {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 14px;
            padding: 0.85rem 1rem;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            transition: all 0.22s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            user-select: none;
            -webkit-user-select: none;
            position: relative;
            overflow: hidden;
        }
        .cyber-chip::before {
            content: '';
            position: absolute;
            inset: 0;
            opacity: 0;
            background: radial-gradient(circle at 50% 0%, rgba(0,176,255,0.12), transparent 70%);
            transition: opacity 0.3s;
        }
        .cyber-chip:hover:not(:disabled)::before { opacity: 1; }
        .cyber-chip:hover:not(:disabled) {
            border-color: rgba(0,176,255,0.45);
            box-shadow: 0 0 18px rgba(0,176,255,0.18), 0 4px 16px rgba(0,0,0,0.4);
            transform: translateY(-3px);
        }
        .cyber-chip:active:not(:disabled) { transform: translateY(0); }
        .cyber-chip:disabled { opacity: 0.35; cursor: not-allowed; }
        .cyber-chip.gold {
            border-color: rgba(212,175,55,0.25);
            background: rgba(212,175,55,0.04);
        }
        .cyber-chip.gold::before {
            background: radial-gradient(circle at 50% 0%, rgba(212,175,55,0.12), transparent 70%);
        }
        .cyber-chip.gold:hover:not(:disabled) {
            border-color: rgba(212,175,55,0.6);
            box-shadow: 0 0 18px rgba(212,175,55,0.2), 0 4px 16px rgba(0,0,0,0.4);
        }
        .chip-icon {
            width: 22px; height: 22px;
            object-fit: contain;
            flex-shrink: 0;
        }
        .chip-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; }
        .chip-text strong { font-size: 0.88rem; font-weight: 800; }
        .chip-text small { font-size: 0.68rem; color: rgba(255,255,255,0.4); font-weight: 500; }

        /* Pulse loading animation */
        .cyber-loader {
            display: inline-flex;
            gap: 4px;
            align-items: center;
            padding: 4px 14px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        .loader-dot {
            width: 6px;
            height: 6px;
            background: #00b0ff;
            border-radius: 50%;
            animation: loadDot 1.2s infinite ease-in-out;
        }
        .loader-dot:nth-child(2) { animation-delay: 0.2s; }
        .loader-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes loadDot {
            0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
            40% { transform: scale(1.2); opacity: 1; }
        }

        /* Holographic Casino Styles */
        .casino-screen {
            display: none;
            padding: 1.5rem;
            background: linear-gradient(180deg, rgba(16, 20, 35, 0.95) 0%, rgba(10, 12, 22, 0.98) 100%);
            border-top: 1px solid rgba(0, 176, 255, 0.2);
            border-bottom: 1px solid rgba(0, 176, 255, 0.2);
            flex-direction: column;
            align-items: center;
            gap: 1.2rem;
            animation: entryFade 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .casino-title {
            font-size: 0.9rem;
            font-weight: 800;
            color: #ffd700;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
            margin-bottom: 0.5rem;
        }
        /* Blackjack Visuals */
        .blackjack-table {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .blackjack-hand-section {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 10px 15px;
            border-radius: var(--border-radius);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .hand-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-secondary);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .hand-score {
            font-size: 0.8rem;
            font-weight: 800;
            background: rgba(0, 176, 255, 0.15);
            color: #00b0ff;
            padding: 2px 8px;
            border-radius: 20px;
            box-shadow: 0 0 8px rgba(0, 176, 255, 0.2);
        }
        .hand-score.dealer {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            box-shadow: 0 0 8px rgba(239, 68, 68, 0.2);
        }
        .cards-list {
            display: flex;
            gap: 8px;
            min-height: 80px;
            align-items: center;
            flex-wrap: wrap;
        }
        .cyber-card {
            width: 50px;
            height: 75px;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.2rem;
            color: #fff;
            position: relative;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            animation: cardDeal 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
            text-shadow: 0 0 5px rgba(255,255,255,0.3);
        }
        .cyber-card.player-card {
            border-color: rgba(0, 176, 255, 0.4);
            box-shadow: 0 0 10px rgba(0, 176, 255, 0.15);
        }
        .cyber-card.dealer-card {
            border-color: rgba(239, 68, 68, 0.4);
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.15);
        }
        .cyber-card.hidden-card {
            background: linear-gradient(135deg, rgba(0, 176, 255, 0.2) 0%, rgba(10, 14, 23, 0.9) 100%);
            border-color: #00b0ff;
            color: #00b0ff;
        }
        @keyframes cardDeal {
            from { transform: translateY(-20px) scale(0.7) rotate(-5deg); opacity: 0; }
            to { transform: translateY(0) scale(1) rotate(0deg); opacity: 1; }
        }

        /* Casino Floor Lobby */
        .casino-lobby {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            padding: 15px;
            box-sizing: border-box;
            background: radial-gradient(circle at center, #111827 0%, #030712 100%);
            border-radius: 12px;
            border: 1px solid rgba(255, 215, 0, 0.15);
            box-shadow: 0 8px 32px rgba(0,0,0,0.8);
        }
        .lobby-header {
            text-align: center;
            margin-bottom: 0.5rem;
        }
        .lobby-header h3 {
            font-size: 1.4rem;
            color: #ffd700;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .lobby-header p {
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin: 4px 0 0 0;
        }
        .casino-floor {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            width: 100%;
            max-width: 700px;
        }
        .casino-table-zone {
            background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);
        }
        .casino-table-zone:hover {
            transform: translateY(-5px);
            border-color: #ffd700;
            box-shadow: 0 8px 25px rgba(255, 215, 0, 0.15);
        }
        .table-visual {
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }
        .table-visual.felt-green {
            background: radial-gradient(circle, #0f5132 0%, #09341f 100%);
            border-bottom: 3px solid #8a6f27;
        }
        .table-visual.felt-wheel {
            background: radial-gradient(circle, #212529 0%, #111417 100%);
            border-bottom: 3px solid #8a6f27;
        }
        .table-visual.felt-purple {
            background: radial-gradient(circle, #3b135c 0%, #200736 100%);
            border-bottom: 3px solid #8a6f27;
        }
        .felt-line {
            position: absolute;
            width: 80%;
            height: 60%;
            border: 1px dashed rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            top: 20%;
        }
        .felt-cards {
            font-size: 2.2rem;
            color: rgba(255, 255, 255, 0.8);
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
            z-index: 2;
        }
        .mini-wheel-rotator {
            font-size: 2.5rem;
            animation: spinWheel 8s linear infinite;
        }
        @keyframes spinWheel {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .slots-visual {
            font-size: 1.8rem;
            letter-spacing: 5px;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
            animation: bounceSlots 1.5s ease-in-out infinite alternate;
        }
        @keyframes bounceSlots {
            from { transform: translateY(-3px); }
            to { transform: translateY(3px); }
        }
        .table-info {
            padding: 10px;
            text-align: center;
            background: rgba(0, 0, 0, 0.3);
        }
        .table-info h4 {
            margin: 0 0 4px 0;
            font-size: 0.95rem;
            font-weight: 700;
            color: #fff;
        }
        .table-info span {
            font-size: 0.75rem;
            color: var(--text-secondary);
        }
        .lobby-exit {
            margin-top: 10px;
            width: 100%;
            max-width: 200px;
        }

        /* Slots game styling */
        .slots-container {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.2rem;
            padding: 15px;
            box-sizing: border-box;
        }
        .slots-machine {
            background: linear-gradient(135deg, #1f1a3a 0%, #0d0b18 100%);
            border: 4px solid #ffd700;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 20px rgba(255, 215, 0, 0.2);
            width: 100%;
            max-width: 340px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }
        .slots-screen-reels {
            background: #000;
            border: 3px solid #3b2f0a;
            border-radius: 8px;
            display: flex;
            gap: 10px;
            padding: 12px;
            justify-content: center;
            width: 100%;
            box-shadow: inset 0 0 15px rgba(0,0,0,1);
        }
        .slots-reel {
            background: #111;
            border: 1px solid rgba(255,255,255,0.05);
