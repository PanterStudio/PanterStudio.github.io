        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playTickSound() {
            try {
                initAudio();
                if (!audioCtx) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(600, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.04);
                gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.04);
            } catch (e) {}
        }

        function drawRouletteWheel(canvas, angle) {
            const ctx = canvas.getContext('2d');
            const cw = canvas.width;
            const ch = canvas.height;
            const cx = cw / 2;
            const cy = ch / 2;
            const r = Math.min(cw, ch) / 2 - 12;
            
            ctx.clearRect(0, 0, cw, ch);
            
            // Draw outer metallic rim
            const outerGrad = ctx.createRadialGradient(cx, cy, r - 6, cx, cy, r + 8);
            outerGrad.addColorStop(0, '#8a6f27');
            outerGrad.addColorStop(0.4, '#ffd700');
            outerGrad.addColorStop(0.6, '#fff7c2');
            outerGrad.addColorStop(0.8, '#ffd700');
            outerGrad.addColorStop(1, '#8a6f27');
            ctx.beginPath();
            ctx.arc(cx, cy, r, 0, Math.PI * 2);
            ctx.lineWidth = 12;
            ctx.strokeStyle = outerGrad;
            ctx.stroke();
            
            // Draw inner shadow ring
            ctx.beginPath();
            ctx.arc(cx, cy, r - 6, 0, Math.PI * 2);
            ctx.lineWidth = 2;
            ctx.strokeStyle = '#000000';
            ctx.stroke();
            
            const wheelNumbers = [0, 32, 15, 19, 4, 21, 2, 25, 17, 34, 6, 27, 13, 36, 11, 30, 8, 23, 10, 5, 24, 16, 33, 1, 20, 14, 31, 9, 22, 18, 29, 7, 28, 12, 35, 3, 26];
            const numSectors = wheelNumbers.length;
            const sectorAngle = (Math.PI * 2) / numSectors;
            
            for (let i = 0; i < numSectors; i++) {
                const currentSectorAngle = angle + i * sectorAngle;
                
                let color;
                if (wheelNumbers[i] === 0) {
                    color = '#10b981';
                } else if (i % 2 === 1) {
                    color = '#ef4444';
                } else {
                    color = '#1f2937';
                }
                
                ctx.beginPath();
                ctx.moveTo(cx, cy);
                ctx.arc(cx, cy, r - 6, currentSectorAngle, currentSectorAngle + sectorAngle);
                ctx.closePath();
                ctx.fillStyle = color;
                ctx.fill();
                
                ctx.beginPath();
                ctx.arc(cx, cy, r - 6, currentSectorAngle, currentSectorAngle + sectorAngle);
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
                ctx.lineWidth = 1;
                ctx.stroke();
                
                ctx.beginPath();
                ctx.moveTo(cx, cy);
                ctx.lineTo(cx + (r - 6) * Math.cos(currentSectorAngle), cy + (r - 6) * Math.sin(currentSectorAngle));
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
                ctx.lineWidth = 1;
                ctx.stroke();
                
                ctx.save();
                ctx.translate(cx, cy);
                ctx.rotate(currentSectorAngle + sectorAngle / 2);
                
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 12px "Courier New", Courier, monospace';
                ctx.shadowColor = 'rgba(0, 0, 0, 0.9)';
                ctx.shadowBlur = 4;
                
                ctx.fillText(wheelNumbers[i], r - 24, 0);
                ctx.restore();
            }
            
            const centerR = 30;
            ctx.beginPath();
            ctx.arc(cx, cy, centerR, 0, Math.PI * 2);
            const innerGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, centerR);
            innerGrad.addColorStop(0, '#ffffff');
            innerGrad.addColorStop(0.2, '#ffd700');
            innerGrad.addColorStop(0.8, '#8a6f27');
            innerGrad.addColorStop(1, '#3b2f0a');
            ctx.fillStyle = innerGrad;
            ctx.shadowColor = 'rgba(0, 0, 0, 0.6)';
            ctx.shadowBlur = 10;
            ctx.shadowOffsetY = 3;
            ctx.fill();
            ctx.shadowBlur = 0;
            
            ctx.beginPath();
            ctx.arc(cx, cy, centerR - 2, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(0, 0, 0, 0.4)';
            ctx.lineWidth = 1.5;
            ctx.stroke();
        }

