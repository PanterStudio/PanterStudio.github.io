        async function executeRouletteSpin(betAmount, playerBetColor) {
            if (isSpinning) return;
            isSpinning = true;
            
            try {
                initAudio();
            } catch(e){}

            const chips = document.getElementById('rouletteChips');
            if (chips) {
                const buttons = chips.querySelectorAll('button');
                buttons.forEach(btn => btn.disabled = true);
            }

            const statusText = document.getElementById('rouletteStatus');
            if (statusText) statusText.innerText = 'Girando la ruleta...';

            logCommand(`apuesta_${playerBetColor.toLowerCase()}`);
            setCoreState('thinking');

            const wheelNumbers = [0, 32, 15, 19, 4, 21, 2, 25, 17, 34, 6, 27, 13, 36, 11, 30, 8, 23, 10, 5, 24, 16, 33, 1, 20, 14, 31, 9, 22, 18, 29, 7, 28, 12, 35, 3, 26];
            const numSectors = wheelNumbers.length;
            const sectorAngle = (Math.PI * 2) / numSectors;
            
            const winIdx = Math.floor(Math.random() * numSectors);
            const winNumber = wheelNumbers[winIdx];
            
            let winColor = 'Verde';
            if (winNumber !== 0) {
                winColor = winIdx % 2 === 1 ? 'Rojo' : 'Negro';
            }

            const canvas = document.getElementById('rouletteCanvas');
            
            const duration = 4000;
            const startAngle = 0;
            
            const spins = 5;
            const targetAngle = (Math.PI * 2 * spins) + (Math.PI * 1.5) - (winIdx * sectorAngle) - (sectorAngle / 2) + (Math.random() * sectorAngle * 0.6 - sectorAngle * 0.3);

            const startTime = performance.now();
            let lastTickAngle = 0;
            
            function animate(now) {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const currentAngle = startAngle + easeOut * targetAngle;
                
                if (canvas) {
                    drawRouletteWheel(canvas, currentAngle);
                }
                
                const angleDiff = currentAngle - lastTickAngle;
                if (angleDiff >= sectorAngle) {
                    playTickSound();
                    lastTickAngle = currentAngle;
                }
                
                if (progress < 1) {
                    rouletteWheelAnimation = requestAnimationFrame(animate);
                } else {
                    finishSpin();
                }
            }
            
            rouletteWheelAnimation = requestAnimationFrame(animate);
            
            async function finishSpin() {
                isSpinning = false;
                
                let won = winColor === playerBetColor;
                let earnings = 0;
                if (won) {
                    if (playerBetColor === 'Verde') {
                        earnings = betAmount * 15;
                    } else {
                        earnings = betAmount;
                    }
                } else {
                    earnings = -betAmount;
                }
                
                let finalCoins = userCoins + earnings;

                if (statusText) {
                    statusText.innerHTML = `¡Cayo en <strong style="color: ${winColor === 'Rojo' ? '#ef4444' : winColor === 'Negro' ? '#9ca3af' : '#10b981'}">${winColor} (${winNumber})</strong>!`;
                }

                try {
                    const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                    await window.setDoc(userDocRef, { coins: finalCoins, updatedAt: new Date().toISOString() }, { merge: true });
                    try {
                        await window.addDoc(window.collection(window.db, 'conductores', currentUser.uid, 'activity'), {
                            type: 'gamble',
                            description: won ? `Gano en Ruleta (+${earnings} 🪙)` : `Perdio en Ruleta (-${betAmount} 🪙)`,
                            coins: earnings,
                            createdAt: new Date().toISOString()
                        });
                    } catch (e) {
                        console.warn("Actividad no registrada:", e);
                    }

                    setCoreState(won ? 'success' : 'error');
                    logAIResponse('Resultado de la Ruleta', `Apostaste al **${playerBetColor}** y cayo **${winColor} (${winNumber})**. ${won ? `¡Felicidades! Ganas **+$${earnings} monedas**.` : `¡Que mala suerte! Pierdes **-$${betAmount} monedas**.`} Saldo: **$${finalCoins} 🪙**.`);

                } catch (err) {
                    console.error(err);
                }

                // CONTINUO JUGANDO DE MANERA INMEDIATA RE-HABILITANDO LAS APUESTAS
                setTimeout(() => {
                    const chips = document.getElementById('rouletteChips');
                    if (chips) {
                        const buttons = chips.querySelectorAll('button');
                        buttons.forEach(btn => btn.disabled = false);
                    }
                    if (statusText) {
                        statusText.innerText = 'Elige tu color para girar la ruleta:';
                    }
                }, 2000);
            }
        }

