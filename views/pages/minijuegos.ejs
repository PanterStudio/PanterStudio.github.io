        function drawReactorGraph(mult) {
            const canvas = document.getElementById('reactorGraphCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0,0,w,h);
            ctx.beginPath();
            ctx.moveTo(0, h);
            
            const progress = (mult - 1) / 5;
            const targetX = Math.min(w * 0.8, w * 0.1 + progress * w);
            const targetY = Math.max(h * 0.2, h - progress * h);
            
            ctx.quadraticCurveTo(w / 2, h, targetX, targetY);
            ctx.strokeStyle = '#ff5722';
            ctx.lineWidth = 4;
            ctx.stroke();

            ctx.shadowColor = '#ff5722';
            ctx.shadowBlur = 8;
            ctx.beginPath();
            ctx.arc(targetX, targetY, 6, 0, Math.PI*2);
            ctx.fillStyle = '#ffffff';
            ctx.fill();
            ctx.shadowBlur = 0;
        }

