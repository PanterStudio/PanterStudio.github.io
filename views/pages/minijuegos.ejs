        function drawOrbitaBoard(ballX = null, ballY = null) {
            const canvas = document.getElementById('orbitaCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0,0,w,h);

            ctx.fillStyle = '#ffffff';
            const rows = 8;
            for(let r = 2; r < rows; r++) {
                const cols = r + 1;
                const rowY = 30 + r * 22;
                const startX = w / 2 - (r * 12);
                for(let c = 0; c < cols; c++) {
                    const pegX = startX + c * 24;
                    ctx.beginPath();
                    ctx.arc(pegX, rowY, 3, 0, Math.PI*2);
                    ctx.fill();
                }
            }

            const binsMult = [5.0, 2.0, 1.0, 0.5, 0.2, 0.5, 1.0, 2.0, 5.0];
            const binW = w / binsMult.length;
            const binY = h - 25;
            
            for(let i = 0; i < binsMult.length; i++) {
                const bx = i * binW;
                ctx.fillStyle = binsMult[i] >= 2.0 ? '#ff5722' : binsMult[i] >= 1.0 ? '#ffd700' : '#1f2937';
                ctx.fillRect(bx + 2, binY, binW - 4, 20);
                
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 9px monospace';
                ctx.textAlign = 'center';
                ctx.fillText(binsMult[i] + 'x', bx + binW/2, binY + 13);
            }

            if (ballX !== null && ballY !== null) {
                ctx.beginPath();
                ctx.arc(ballX, ballY, 6, 0, Math.PI*2);
                ctx.fillStyle = '#00e5ff';
                ctx.shadowColor = '#00e5ff';
                ctx.shadowBlur = 10;
                ctx.fill();
                ctx.shadowBlur = 0;
            }
        }

        function executeOrbitaSpin() {
            if (orbitaActive) return;
            orbitaActive = true;

            try {
                initAudio();
            } catch(e){}

            const lanzarBtn = document.getElementById('orbitaLanzarBtn');
            if (lanzarBtn) lanzarBtn.disabled = true;

            const statusText = document.getElementById('orbitaStatus');
            statusText.innerText = 'Paquete de datos cayendo...';

            logCommand(`lanzar_orbita_${orbitaBet}`);
            setCoreState('thinking');

            const canvas = document.getElementById('orbitaCanvas');
            const w = canvas.width;
            const h = canvas.height;

            let bx = w / 2;
            let by = 15;
            let row = 1;
            const maxRows = 8;
            
            drawOrbitaBoard(bx, by);

            const interval = setInterval(() => {
                if (row < maxRows) {
                    const dir = Math.random() < 0.5 ? -12 : 12;
                    bx += dir;
                    by += 22;
                    row++;
                    playTickSound();
                    drawOrbitaBoard(bx, by);
                } else {
                    clearInterval(interval);
                    const binsMult = [5.0, 2.0, 1.0, 0.5, 0.2, 0.5, 1.0, 2.0, 5.0];
                    const binW = w / binsMult.length;
                    let binIdx = Math.floor(bx / binW);
                    if (binIdx < 0) binIdx = 0;
                    if (binIdx >= binsMult.length) binIdx = binsMult.length - 1;

                    const mult = binsMult[binIdx];
                    evaluateOrbitaResult(mult);
                }
            }, 180);
        }

