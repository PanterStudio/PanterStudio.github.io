        function bjStand() {
            if (!activeBlackjack) return;
            logCommand('plantarse');
            setCoreState('thinking');

            setTimeout(() => {
                let dealerSum = activeBlackjack.dealer.reduce((a,b)=>a+b, 0);
                while (dealerSum < 17) {
                    const card = Math.floor(Math.random() * 10) + 1;
                    activeBlackjack.dealer.push(card);
                    dealerSum = activeBlackjack.dealer.reduce((a,b)=>a+b, 0);
                }

                updateBlackjackVisuals(true);
                const playerSum = activeBlackjack.player.reduce((a,b)=>a+b, 0);

                if (dealerSum > 21) {
                    resolveBlackjack(true, `¡El Crupier se paso de 21! (Crupier: **${dealerSum}** vs Tu: **${playerSum}**)`);
                } else if (playerSum > dealerSum) {
                    resolveBlackjack(true, `¡Le ganaste al Crupier! Puntuacion mayor. (Crupier: **${dealerSum}** vs Tu: **${playerSum}**)`);
                } else if (playerSum === dealerSum) {
                    resolveBlackjack(null, `¡Empate! Se devuelven las monedas apostadas. (Crupier: **${dealerSum}** vs Tu: **${playerSum}**)`);
                } else {
                    resolveBlackjack(false, `Perdiste. El Crupier saco mejor puntuacion. (Crupier: **${dealerSum}** vs Tu: **${playerSum}**)`);
                }
            }, 600);
        }

