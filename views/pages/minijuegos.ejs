<script>
        let currentUser = null;
        let userCoins = 0;
        let cooldowns = {
            work: Number(localStorage.getItem('panterAI_cooldown_work') || 0),
            risk: Number(localStorage.getItem('panterAI_cooldown_risk') || 0)
        };
        let activeBlackjack = null;

        function waitForFirebase(timeout = 7000) {
            return new Promise((resolve) => {
                if (window.auth && window.db && window.fsDoc) return resolve(true);
                const start = Date.now();
                const timer = setInterval(() => {
                    if (window.auth && window.db && window.fsDoc) {
                        clearInterval(timer);
                        resolve(true);
                    } else if (Date.now() - start > timeout) {
                        clearInterval(timer);
                        resolve(false);
                    }
                }, 100);
            });
        }

        // ─── CONTROL DE INTERFAZ DASHBOARD Y TIENDA ───
        // ─── CONTROL DE INTERFAZ DASHBOARD Y TIENDA ───
        function switchCoreMode(mode) {
            const termContainer = document.getElementById('gameContainer');
            const storeContainer = document.getElementById('storeContainer');
            const petContainer = document.getElementById('petContainer');
            const inventoryContainer = document.getElementById('inventoryContainer');
            const btnDashTerminal = document.getElementById('btnDashTerminal');
            const btnDashStore = document.getElementById('btnDashStore');
            const btnDashPet = document.getElementById('btnDashPet');
            const btnDashInventory = document.getElementById('btnDashInventory');

            // Hide the dashboard card choices when opening either panel
            document.getElementById('coreDashboard').style.display = 'none';

            if (mode === 'terminal') {
                termContainer.style.display = 'flex';
                storeContainer.style.display = 'none';
                if (petContainer) petContainer.style.display = 'none';
                if (inventoryContainer) inventoryContainer.style.display = 'none';
                
                if (btnDashTerminal) {
                    btnDashTerminal.classList.add('active');
                    btnDashTerminal.querySelector('.btn').classList.remove('btn-ghost');
                }
                if (btnDashStore) {
                    btnDashStore.classList.remove('active');
                    btnDashStore.querySelector('.btn').classList.add('btn-ghost');
                }
                if (btnDashPet) {
                    btnDashPet.classList.remove('active');
                    btnDashPet.querySelector('.btn').classList.add('btn-ghost');
                }
                if (btnDashInventory) {
                    btnDashInventory.classList.remove('active');
                    btnDashInventory.querySelector('.btn').classList.add('btn-ghost');
                }
            } else if (mode === 'store') {
                termContainer.style.display = 'none';
                storeContainer.style.display = 'block'; // block container wraps grid/tabs
                if (petContainer) petContainer.style.display = 'none';
                if (inventoryContainer) inventoryContainer.style.display = 'none';
                
                if (btnDashTerminal) {
                    btnDashTerminal.classList.remove('active');
                    btnDashTerminal.querySelector('.btn').classList.add('btn-ghost');
                }
                if (btnDashStore) {
                    btnDashStore.classList.add('active');
                    btnDashStore.querySelector('.btn').classList.remove('btn-ghost');
                }
                if (btnDashPet) {
                    btnDashPet.classList.remove('active');
                    btnDashPet.querySelector('.btn').classList.add('btn-ghost');
                }
                if (btnDashInventory) {
                    btnDashInventory.classList.remove('active');
                    btnDashInventory.querySelector('.btn').classList.add('btn-ghost');
                }
                
                // Reset store filters to show all by default when entering store
                filterStore('all');
            } else if (mode === 'pet') {
                termContainer.style.display = 'none';
                storeContainer.style.display = 'none';
                if (petContainer) petContainer.style.display = 'flex';
                if (inventoryContainer) inventoryContainer.style.display = 'none';
                
                if (btnDashTerminal) {
                    btnDashTerminal.classList.remove('active');
                    btnDashTerminal.querySelector('.btn').classList.add('btn-ghost');
                }
                if (btnDashStore) {
                    btnDashStore.classList.remove('active');
                    btnDashStore.querySelector('.btn').classList.add('btn-ghost');
                }
                if (btnDashPet) {
                    btnDashPet.classList.add('active');
                    btnDashPet.querySelector('.btn').classList.remove('btn-ghost');
                }
                if (btnDashInventory) {
                    btnDashInventory.classList.remove('active');
                    btnDashInventory.querySelector('.btn').classList.add('btn-ghost');
                }
                
                // Load or sync pet data
                syncPetData();
            } else if (mode === 'inventory') {
                termContainer.style.display = 'none';
                storeContainer.style.display = 'none';
                if (petContainer) petContainer.style.display = 'none';
                if (inventoryContainer) inventoryContainer.style.display = 'block';
                
                if (btnDashTerminal) {
                    btnDashTerminal.classList.remove('active');
                    btnDashTerminal.querySelector('.btn').classList.add('btn-ghost');
                }
                if (btnDashStore) {
                    btnDashStore.classList.remove('active');
                    btnDashStore.querySelector('.btn').classList.add('btn-ghost');
