        function spawnBypassNodes() {
            if (!activeRiskActive || activeRiskType !== 0) return;
            const grid = document.getElementById('bypassGrid');
            if (!grid) return;

            grid.innerHTML = '';
            
            // Generar 1 nodo verde activo y 3 firewalls rojos diferentes
            riskActiveNodeIdx = Math.floor(Math.random() * 9);
            
            riskFirewallNodes = [];
            while (riskFirewallNodes.length < 3) {
                const idx = Math.floor(Math.random() * 9);
                if (idx !== riskActiveNodeIdx && !riskFirewallNodes.includes(idx)) {
                    riskFirewallNodes.push(idx);
                }
            }

            for (let i = 0; i < 9; i++) {
                const node = document.createElement('div');
                node.className = 'bypass-node';
                node.innerText = '⚙️';

                if (i === riskActiveNodeIdx) {
                    node.className += ' active-node';
                    node.innerText = '🔓';
                    node.onclick = () => {
                        if (!activeRiskActive) return;
                        riskHackedCount++;
                        try {
                            playTickSound();
                        } catch(e){}

                        const scoreLabel = document.getElementById('riskScore');
                        if (scoreLabel) scoreLabel.innerText = `Nodos Hackeados: ${riskHackedCount} / 7`;

                        if (riskHackedCount >= 7) {
                            clearInterval(activeRiskTimer);
                            activeRiskActive = false;
                            finishRiskGame(true, '¡Bypass de red completado con exito!');
                        } else {
                            spawnBypassNodes();
                        }
                    };
                } else if (riskFirewallNodes.includes(i)) {
                    node.className += ' firewall-node';
                    node.innerText = '🛡️';
                    node.onclick = () => {
                        if (!activeRiskActive) return;
                        clearInterval(activeRiskTimer);
                        activeRiskActive = false;
                        finishRiskGame(false, '¡Cortocircuito de firewall detectado! Alarma activada.');
                    };
                }

                grid.appendChild(node);
            }
        }

        function pressPinDigit(num) {
            if (!activeRiskActive || activeRiskType !== 1) return;
            
