                        type: 'profile',
                        description: `Adoptaste a tu mascota virtual: ${name} 🐾`,
                        coins: 0,
                        createdAt: new Date().toISOString()
                    });
                } catch(e){}
                
                syncPetData();
            } catch(err) {
                console.error(err);
                alert('Error al adoptar la mascota.');
            }
        }

        function syncPetData() {
            if (!currentUser) return;
            if (!currentPetData) {
                document.getElementById('petAdoptionPanel').style.display = 'flex';
                document.getElementById('petActivePanel').style.display = 'none';
                return;
            }

            document.getElementById('petAdoptionPanel').style.display = 'none';
            document.getElementById('petActivePanel').style.display = 'grid';

            // Calculate decay based on time elapsed since lastUpdate
            const last = new Date(currentPetData.lastUpdate);
            const now = new Date();
            const elapsedSeconds = Math.max(0, Math.floor((now - last) / 1000));

            if (elapsedSeconds > 10) {
                // Hunger decay: 1% every 5 minutes (300 seconds)
                // Happiness decay: 1% every 7 minutes (420 seconds)
                // Energy decay: 1% every 6 minutes (360 seconds)
                // Sleeping recovery: 1% every 2 minutes (120 seconds)
                const hungerDecay = Math.floor(elapsedSeconds / 300);
                const happinessDecay = Math.floor(elapsedSeconds / 420);
                
                let energyDelta = 0;
                if (currentPetData.isSleeping) {
                    energyDelta = Math.floor(elapsedSeconds / 120);
                } else {
                    energyDelta = -Math.floor(elapsedSeconds / 360);
                }

                currentPetData.hunger = Math.max(0, currentPetData.hunger - hungerDecay);
                currentPetData.happiness = Math.max(0, currentPetData.happiness - happinessDecay);
                currentPetData.energy = Math.max(0, Math.min(100, currentPetData.energy + energyDelta));
                currentPetData.lastUpdate = now.toISOString();

                // Save updated values to Firestore
                const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                window.setDoc(userDocRef, { pet: currentPetData }, { merge: true }).catch(err => console.error(err));
            }

            updatePetUI();

            // Set a timer for live updates
            if (petDecayTimer) clearInterval(petDecayTimer);
            petDecayTimer = setInterval(() => {
                if (currentPetData) {
                    if (currentPetData.isSleeping) {
                        currentPetData.energy = Math.min(100, currentPetData.energy + 1);
                    } else {
                        // Regular live decay every minute
                        currentPetData.hunger = Math.max(0, currentPetData.hunger - 0.2);
                        currentPetData.happiness = Math.max(0, currentPetData.happiness - 0.15);
                        currentPetData.energy = Math.max(0, currentPetData.energy - 0.1);
                    }
                    updatePetUI();
                }
            }, 30000); // every 30 seconds
        }

        const PET_AVATARS = {
            classic: '🐈‍⬛',
            cyber: '🤖🐈‍⬛',
            astronaut: '👨‍🚀🐈‍⬛',
            detective: '🕵️🐈‍⬛',
            golden: '👑🐈‍⬛'
        };

        function updatePetUI() {
            if (!currentPetData) return;

            const hunger = Math.round(currentPetData.hunger || 0);
            const happiness = Math.round(currentPetData.happiness || 0);
            const energy = Math.round(currentPetData.energy || 0);
            const level = currentPetData.level || 1;
            const exp = currentPetData.exp || 0;
            const name = currentPetData.name || 'Pantercito';
            const avatarId = currentPetData.avatarId || 'classic';
            
            // Set basic values
            document.getElementById('petLevelDisplay').textContent = level;
            document.getElementById('petNameDisplay').textContent = name;
            
            // Set avatar visual representation
            const visual = PET_AVATARS[avatarId] || '🐈‍⬛';
            document.getElementById('petVisual').textContent = visual;

            // Set progress bars
            document.getElementById('petHungerText').textContent = `${hunger}%`;
            document.getElementById('petHungerBar').style.width = `${hunger}%`;
            
            document.getElementById('petHappinessText').textContent = `${happiness}%`;
            document.getElementById('petHappinessBar').style.width = `${happiness}%`;
            
            document.getElementById('petEnergyText').textContent = `${energy}%`;
            document.getElementById('petEnergyBar').style.width = `${energy}%`;

            const nextLevelExp = level * 500;
            document.getElementById('petExpText').textContent = `${exp} / ${nextLevelExp}`;
            document.getElementById('petExpFill').style.width = `${Math.min(100, (exp / nextLevelExp) * 100)}%`;

            // State and reactions
            let stateText = 'Cachorro Feliz';
            let reaction = '';

            if (currentPetData.isSleeping) {
                stateText = 'Durmiendo... 💤';
                document.getElementById('petVisual').style.animation = 'petBreath 1s ease-in-out infinite';
                document.getElementById('petSleepBtnText').innerHTML = '<strong>Despertar</strong><small>Activar mascota</small>';
                document.getElementById('petStatusLabel').textContent = 'MASCOTA DURMIENDO';
                document.getElementById('petStatusLabel').style.color = '#ffd700';
            } else {
                document.getElementById('petVisual').style.animation = 'petBreath 3s ease-in-out infinite';
                document.getElementById('petSleepBtnText').innerHTML = '<strong>Dormir</strong><small>Recupera Energía</small>';
                document.getElementById('petStatusLabel').textContent = 'PANTERA CACHORRO EN LÍNEA';
                document.getElementById('petStatusLabel').style.color = '#00e676';

                if (hunger < 30) {
                    stateText = 'Muy hambriento 🥩';
                    reaction = '¡Tengo mucha hambre! ¿Me das de comer? 🥺';
                } else if (happiness < 30) {
                    stateText = 'Aburrido 🧶';
                    reaction = 'Estoy un poco aburrido... ¿Jugamos? 🥺';
                } else if (energy < 20) {
                    stateText = 'Cansado 💤';
                    reaction = 'Estoy muy cansado. Debería ir a dormir... 😴';
                } else {
                    stateText = 'Jugando felizmente ✨';
                }
            }

            document.getElementById('petStateText').textContent = stateText;
            
            const bubble = document.getElementById('petReactionBubble');
            if (reaction) {
                bubble.textContent = reaction;
                bubble.style.display = 'block';
            } else {
                bubble.style.display = 'none';
            }
        }

        async function interactPet(action) {
            if (!currentUser || !currentPetData) return;
            const now = new Date();

            if (currentPetData.isSleeping && action !== 'sleep') {
                alert('¡Shhh! Tu mascota está durmiendo. Despiértala primero.');
                return;
            }

            const visual = document.getElementById('petVisual');

            if (action === 'feed') {
                if (userCoins < 20) {
                    alert('No tienes suficientes monedas web (necesitas 20 🪙).');
                    return;
                }
                if (currentPetData.hunger >= 100) {
                    alert('Tu mascota ya está llena.');
                    return;
                }

                currentPetData.hunger = Math.min(100, currentPetData.hunger + 30);
                addPetExp(50);
                currentPetData.lastUpdate = now.toISOString();
                
                // Rest coins
                try {
                    const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                    await window.updateDoc(userDocRef, {
                        coins: userCoins - 20,
                        pet: currentPetData
                    });
                    
                    // Trigger jump animation
                    visual.classList.add('pet-jump-animation');
                    setTimeout(() => visual.classList.remove('pet-jump-animation'), 500);
                } catch(e) {
                    console.error(e);
                }
            } else if (action === 'play') {
                if (currentPetData.energy < 20) {
                    alert('Tu mascota no tiene suficiente energía (necesita al menos 20 ⚡).');
                    return;
                }
                if (currentPetData.happiness >= 100) {
                    alert('Tu mascota ya está súper feliz.');
                    return;
                }

                currentPetData.energy = Math.max(0, currentPetData.energy - 20);
                currentPetData.happiness = Math.min(100, currentPetData.happiness + 40);
                addPetExp(75);
                currentPetData.lastUpdate = now.toISOString();

                try {
                    const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                    await window.updateDoc(userDocRef, { pet: currentPetData });
                    
                    visual.classList.add('pet-jump-animation');
                    setTimeout(() => visual.classList.remove('pet-jump-animation'), 500);
                } catch(e) {
                    console.error(e);
                }
            } else if (action === 'train') {
                if (currentPetData.energy < 30) {
                    alert('Tu mascota no tiene suficiente energía para entrenar (necesita al menos 30 ⚡).');
                    return;
                }

                currentPetData.energy = Math.max(0, currentPetData.energy - 30);
                addPetExp(100);
                currentPetData.lastUpdate = now.toISOString();

                try {
                    const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                    await window.updateDoc(userDocRef, {
                        coins: userCoins + 50,
                        pet: currentPetData
                    });

                    // Activity log for pet training earnings
                    await window.addDoc(window.collection(window.db, 'conductores', currentUser.uid, 'activity'), {
                        type: 'daily',
                        description: `Entrenamiento de Mascota (+50 🪙)`,
                        coins: 50,
                        createdAt: new Date().toISOString()
                    });
                    
                    visual.classList.add('pet-jump-animation');
                    setTimeout(() => visual.classList.remove('pet-jump-animation'), 500);
                } catch(e) {
                    console.error(e);
                }
            } else if (action === 'sleep') {
                currentPetData.isSleeping = !currentPetData.isSleeping;
                currentPetData.lastUpdate = now.toISOString();

                try {
                    const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                    await window.updateDoc(userDocRef, { pet: currentPetData });
                } catch(e) {
                    console.error(e);
                }
            }
        }

        function addPetExp(amount) {
            currentPetData.exp += amount;
            const nextLevelExp = currentPetData.level * 500;
            if (currentPetData.exp >= nextLevelExp) {
                currentPetData.exp -= nextLevelExp;
                currentPetData.level += 1;
                
                // Show glitch/level up animation
                const visual = document.getElementById('petVisual');
                visual.classList.add('pet-glitch-animation');
                setTimeout(() => visual.classList.remove('pet-glitch-animation'), 800);

                // Add unlocked avatars as they level up
                if (currentPetData.level >= 3 && !currentPetData.unlockedAvatars.includes('cyber')) {
                    currentPetData.unlockedAvatars.push('cyber');
                }
                if (currentPetData.level >= 5 && !currentPetData.unlockedAvatars.includes('golden')) {
                    currentPetData.unlockedAvatars.push('golden');
                }

                alert(`¡Felicidades! Tu mascota ha subido al Nivel ${currentPetData.level}! 🎉`);
            }
        }

        document.addEventListener('DOMContentLoaded', initAIGame);
    </script>

