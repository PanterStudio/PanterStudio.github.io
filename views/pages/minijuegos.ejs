                initAudio();
            } catch(e){}

            const controls = document.getElementById('slotsControls');
            if (controls) {
                const buttons = controls.querySelectorAll('button');
                buttons.forEach(btn => btn.disabled = true);
            }

            const statusText = document.getElementById('slotsStatus');
            if (statusText) statusText.innerText = 'Girando rodillos...';

            logCommand(`girar_slots_${betAmount}`);
            setCoreState('thinking');

            const symbols = ['🪙', '🍒', '🔥', '💎', '👑'];
            const reel1 = document.getElementById('slotsReel1');
            const reel2 = document.getElementById('slotsReel2');
            const reel3 = document.getElementById('slotsReel3');

            let spins1 = 0, spins2 = 0, spins3 = 0;
            const maxSpins1 = 15, maxSpins2 = 25, maxSpins3 = 35;

            const interval = setInterval(() => {
                if (spins1 < maxSpins1) {
                    reel1.innerText = symbols[Math.floor(Math.random() * symbols.length)];
                    spins1++;
                    if (spins1 % 3 === 0) playTickSound();
                }
                if (spins2 < maxSpins2) {
                    reel2.innerText = symbols[Math.floor(Math.random() * symbols.length)];
                    spins2++;
                    if (spins2 % 3 === 0) playTickSound();
                }
                if (spins3 < maxSpins3) {
                    reel3.innerText = symbols[Math.floor(Math.random() * symbols.length)];
                    spins3++;
                    if (spins3 % 3 === 0) playTickSound();
                }

                if (spins1 >= maxSpins1 && spins2 >= maxSpins2 && spins3 >= maxSpins3) {
                    clearInterval(interval);
                    evaluateSlotsResult(betAmount, reel1.innerText, reel2.innerText, reel3.innerText);
                }
            }, 70);
        }

        async function evaluateSlotsResult(betAmount, s1, s2, s3) {
            isSlotsSpinning = false;
            const statusText = document.getElementById('slotsStatus');
            
            let multiplier = 0;
            let won = false;
            let resultName = '';

            if (s1 === s2 && s2 === s3) {
                won = true;
                if (s1 === '👑') { multiplier = 50; resultName = 'TRES CORONAS 👑'; }
                else if (s1 === '💎') { multiplier = 30; resultName = 'TRES ESMERALDAS 💎'; }
                else if (s1 === '🔥') { multiplier = 15; resultName = 'TRIPLE FUEGO 🔥'; }
                else if (s1 === '🍒') { multiplier = 8; resultName = 'TRES CEREZAS 🍒'; }
                else { multiplier = 5; resultName = 'TRES MONEDAS 🪙'; }
            } else if (s1 === s2 || s1 === s3 || s2 === s3) {
                won = true;
                multiplier = 2;
                resultName = 'PAREJA COINCIDENTE';
            }

            let earnings = 0;
            if (won) {
                earnings = betAmount * (multiplier - 1);
            } else {
                earnings = -betAmount;
            }

            let finalCoins = userCoins + earnings;

            if (statusText) {
                if (won) {
                    statusText.innerHTML = `¡Ganaste! Obtenido: <strong style="color:#ffd700;">${resultName}</strong> (+${earnings} 🪙)`;
                } else {
                    statusText.innerHTML = `Sin suerte: <strong>${s1} | ${s2} | ${s3}</strong> (-${betAmount} 🪙)`;
                }
            }

            try {
                const docRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                await window.setDoc(docRef, { coins: finalCoins, updatedAt: new Date().toISOString() }, { merge: true });
                try {
                    await window.addDoc(window.collection(window.db, 'conductores', currentUser.uid, 'activity'), {
                        type: 'gamble',
                        description: won ? `Gano en Recombinador (+${earnings} 🪙)` : `Perdio en Recombinador (-${betAmount} 🪙)`,
                        coins: earnings,
                        createdAt: new Date().toISOString()
                    });
                } catch(e){}

                setCoreState(won ? 'success' : 'error');
                logAIResponse('Resultado de Recombinador', `Reeles: **${s1} | ${s2} | ${s3}**. ${won ? `¡Felicidades! Ganas **+$${earnings} monedas** (${resultName}).` : `Perdiste **-$${betAmount} monedas**.`} Saldo: **$${finalCoins} 🪙**.`);
            } catch(e){
                console.error(e);
            }

            // RE-HABILITAR CONTROLES DE MANERA INMEDIATA PARA SEGUIR JUGANDO SIN SALIR
            setTimeout(() => {
                const controls = document.getElementById('slotsControls');
                if (controls) {
                    const buttons = controls.querySelectorAll('button');
                    buttons.forEach(btn => btn.disabled = false);
                }
                if (statusText) {
                    statusText.innerText = '¡Tira de la palanca de nuevo!';
                }
            }, 1800);
        }

