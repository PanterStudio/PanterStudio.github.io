                    finishRiskGame(false, '¡Cortocircuito de cables!');
                }
            }
        }

        async function finishRiskGame(success, reason) {
            const screen = document.getElementById('casinoVisualScreen');
            
            let amount = success ? 70 : 30; // Max 70 monedas exito, 30 multa
            let finalCoins = (Number(userCoins) || 0);

            let insuranceUsed = false;
            let currentInsurance = 0;

            if (success) {
                finalCoins += amount;
            } else {
                // Check if user has insurance
                try {
                    const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                    const docSnap = await window.getDoc(userDocRef);
                    if (docSnap.exists()) {
                        const data = docSnap.data();
                        currentInsurance = Number(data.riskInsurance || 0);
                        if (currentInsurance > 0) {
                            insuranceUsed = true;
                        }
                    }
                } catch(e) {
                    console.warn('Fallo al comprobar seguro:', e);
                }

                if (insuranceUsed) {
                    // Protected by insurance!
                    reason = `🛡️ [SEGURO DE MISIÓN ACTIVADO] ${reason} Tu seguro ha absorbido la multa.`;
                } else {
                    finalCoins = Math.max(0, finalCoins - amount);
                }
            }

            try {
                const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
                const updateData = { 
                    coins: finalCoins, 
                    updatedAt: new Date().toISOString() 
                };

                if (insuranceUsed) {
                    updateData.riskInsurance = currentInsurance - 1;
                }

                await window.setDoc(userDocRef, updateData, { merge: true });
                
                try {
                    await window.addDoc(window.collection(window.db, 'conductores', currentUser.uid, 'activity'), {
                        type: 'crime',
                        description: success ? `Exito en Mision de Riesgo (+${amount} 🪙)` : (insuranceUsed ? `Fallo Protegido en Mision de Riesgo (0 🪙)` : `Fallo en Mision de Riesgo (-${amount} 🪙)`),
                        coins: success ? amount : (insuranceUsed ? 0 : -amount),
                        createdAt: new Date().toISOString()
                    });
                } catch (e) {
                    console.warn("Actividad no registrada:", e);
                }

                setCoreState(success ? 'success' : (insuranceUsed ? 'success' : 'error'));
                logAIResponse(success ? 'Mision Completada' : (insuranceUsed ? '🛡️ Multa Cancelada' : 'Mision Fallida'), `${reason} ${success ? `Ganancia: +$${amount} monedas.` : (insuranceUsed ? `¡Sin cobro de multa!` : `Te aplican una multa de -$${amount} monedas.`)} Saldo total: $${finalCoins} 🪙.`);
            } catch (err) {
                console.error(err);
                setCoreState('error');
                logAIResponse('Falla del Sistema', `No se pudo guardar el progreso. Detalle: ${err.message}`);
            }

            setTimeout(() => {
                resetControls();
            }, 2500);
        }

