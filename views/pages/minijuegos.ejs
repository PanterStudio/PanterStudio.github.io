        function clickPort(side, color) {
            if (!activeRiskActive || activeRiskType !== 2) return;
            try {
                playTickSound();
            } catch(e){}

            const wireStatusText = document.getElementById('wireStatusText');

            if (side === 'left') {
                selectedLeftPort = color;
                if (wireStatusText) wireStatusText.innerText = `Conecta el cable ${color.toUpperCase()}`;
                
                ['rojo', 'azul', 'verde', 'amarillo'].forEach(col => {
                    const el = document.getElementById(`left-${col}`);
                    if (el) el.style.boxShadow = (col === color) ? '0 0 10px #fff' : 'none';
                });
            } else if (side === 'right') {
                if (!selectedLeftPort) {
                    if (wireStatusText) wireStatusText.innerText = 'Selecciona puerto izquierdo!';
                    return;
                }
                if (color === selectedLeftPort) {
                    connectedWires++;
                    if (wireStatusText) wireStatusText.innerText = `Cables: ${connectedWires} / 4`;
                    
                    const leftEl = document.getElementById(`left-${color}`);
                    const rightEl = document.getElementById(`right-${color}`);
                    if (leftEl) { leftEl.style.opacity = '0.3'; leftEl.onclick = null; leftEl.style.boxShadow = 'none'; }
                    if (rightEl) { rightEl.style.opacity = '0.3'; rightEl.onclick = null; }
                    
                    selectedLeftPort = null;
                    
                    if (connectedWires >= 4) {
                        clearInterval(activeRiskTimer);
                        activeRiskActive = false;
                        finishRiskGame(true, '¡Cableado reconectado con exito!');
                    }
                } else {
                    clearInterval(activeRiskTimer);
