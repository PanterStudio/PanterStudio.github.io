                clearInterval(activeRiskTimer);
                activeRiskActive = false;
                finishRiskGame(false, '¡PIN incorrecto! Alarma activada.');
                return;
            }

            currentPinInput += num;
            const pinDisplay = document.getElementById('pinDisplay');
            if (pinDisplay) pinDisplay.innerText = currentPinInput.padEnd(5, ' -').substring(0, 9);
            
            try {
                playTickSound();
