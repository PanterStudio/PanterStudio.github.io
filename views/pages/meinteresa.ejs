<script>
    // ===== ME INTERESA LOGIC =====
    let currentUser = null;
    let isInterested = false;

    function waitForFirebase(timeout = 8000) {
        return new Promise((resolve) => {
            if (window.db && window.fsDoc && window.getDoc && window.setDoc && window.auth && window.collection && window.query && window.where && window.getDocs) return resolve(true);
            const start = Date.now();
            const t = setInterval(() => {
                if (window.db && window.fsDoc && window.getDoc && window.setDoc && window.auth && window.collection && window.query && window.where && window.getDocs) {
                    clearInterval(t); resolve(true);
                } else if (Date.now() - start > timeout) {
                    clearInterval(t); resolve(false);
                }
            }, 100);
        });
    }

    function setStatus(msg, type = 'info') {
        const el = document.getElementById('miStatus');
        if (!el) return;
        el.textContent = msg;
        el.className = type;
    }

    function setContador(n) {
        const el = document.getElementById('miContador');
        if (!el) return;
        el.textContent = typeof n === 'number' ? n.toLocaleString() : n;
    }

    function setVotedState(voted) {
        const btn = document.getElementById('miInteresaBtn');
        const txt = document.getElementById('miBtnText');
        if (voted) {
            if (btn) {
                btn.classList.remove('not-voted');
                btn.classList.add('voted');
            }
            if (txt) txt.textContent = '¡Ya marcaste tu interés! (Quitar)';
            setStatus('✅ ¡Gracias! Has marcado que te interesa el juego.', 'success');
        } else {
            if (btn) {
                btn.classList.add('not-voted');
                btn.classList.remove('voted');
            }
            if (txt) txt.textContent = '¡Me Interesa el Juego!';
            setStatus('¿Te interesa el juego? ¡Haz clic y cuéntanos!', 'info');
        }
    }

    async function cargarContador() {
        const ok = await waitForFirebase();
        if (!ok) {
            setContador('—');
            setStatus('No se pudo conectar. Intenta de nuevo.', 'error');
            return;
        }

        // 1. Obtener conteo total consultando usuarios con interested == true
        try {
            const q = window.query(window.collection(window.db, 'conductores'), window.where('interested', '==', true));
            const snap = await window.getDocs(q);
            setContador(snap.size);
        } catch (e) {
            console.warn('Error cargando contador total:', e);
            setContador('—');
        }

        // 2. Escuchar cambios de Auth para ver si el usuario ya votó
        window.auth.onAuthStateChanged(async (user) => {
            const btn = document.getElementById('miInteresaBtn');
            const txt = document.getElementById('miBtnText');
            
            if (user) {
                currentUser = user;
                try {
                    const userDocRef = window.fsDoc(window.db, 'conductores', user.uid);
                    const userSnap = await window.getDoc(userDocRef);
                    if (userSnap.exists()) {
                        isInterested = !!userSnap.data().interested;
                    } else {
                        isInterested = false;
                    }
                    setVotedState(isInterested);
                } catch (e) {
                    console.warn('Error obteniendo estado de interes del usuario:', e);
                    setStatus('Error al verificar tu perfil.', 'error');
                }
            } else {
                currentUser = null;
                isInterested = false;
                if (btn) {
                    btn.classList.add('not-voted');
                    btn.classList.remove('voted');
                    btn.removeAttribute('disabled');
                }
                if (txt) txt.textContent = '¡Me Interesa el Juego!';
                setStatus('Conéctate en "Mi Perfil" para registrar tu interés.', 'info');
            }
        });
    }

    async function registrarInteres() {
        const ok = await waitForFirebase();
        if (!ok) {
            setStatus('Sin conexión. Intenta de nuevo.', 'error');
            return;
        }

        if (!currentUser) {
            setStatus('⚠️ Debes iniciar sesión en la pestaña "Mi Perfil" primero.', 'error');
            return;
        }

        const btn = document.getElementById('miInteresaBtn');
        if (btn) btn.setAttribute('disabled', 'true');
        setStatus('Guardando...', 'info');

        try {
            const userDocRef = window.fsDoc(window.db, 'conductores', currentUser.uid);
            const nextState = !isInterested;

            // Actualizar el estado del usuario en Firestore (incluyendo updatedAt para cumplir las reglas)
            await window.setDoc(userDocRef, {
                interested: nextState,
                updatedAt: new Date().toISOString()
            }, { merge: true });

            isInterested = nextState;
            setVotedState(isInterested);

            // Re-calcular total
            const q = window.query(window.collection(window.db, 'conductores'), window.where('interested', '==', true));
            const snap = await window.getDocs(q);
            const newTotal = snap.size;
            setContador(newTotal);

            const counterEl = document.getElementById('miContador');
            if (counterEl) counterEl.classList.add('celebrate');
            setTimeout(() => counterEl?.classList.remove('celebrate'), 600);

        } catch (e) {
            console.error('Error registrando interés:', e);
            setStatus('No se pudo guardar. Intenta de nuevo.', 'error');
        } finally {
            if (btn) btn.removeAttribute('disabled');
        }
    }

    document.addEventListener('DOMContentLoaded', cargarContador);
    </script>

