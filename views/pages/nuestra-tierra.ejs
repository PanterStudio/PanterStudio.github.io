    <style>
        /* Interactive Tab System Styles */
        .nt-tabs-nav {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 0.5rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .nt-tab-btn {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #94a3b8;
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .nt-tab-btn:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.08);
        }

        .nt-tab-btn.active {
            background: var(--nt-blue);
            color: #0b0f19;
            border-color: var(--nt-blue);
            box-shadow: 0 4px 15px rgba(0, 176, 255, 0.25);
        }

        .nt-tab-panel {
            display: none;
            animation: fadeInNT 0.3s ease;
            margin-bottom: 3.5rem;
        }

        .nt-tab-panel.active {
            display: block;
        }

        .nt-interactive-card {
            padding: 1.5rem;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: all 0.25s ease;
        }

        .nt-interactive-card:hover {
            transform: translateY(-4px);
            border-color: rgba(0, 176, 255, 0.3);
            background: rgba(255, 255, 255, 0.04);
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        }

        @keyframes fadeInNT {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>

    <script>
        function switchNTTab(evt, tabId) {
            const panels = document.querySelectorAll('.nt-tab-panel');
            const btns = document.querySelectorAll('.nt-tab-btn');

            panels.forEach(panel => panel.classList.remove('active'));
            btns.forEach(btn => btn.classList.remove('active'));

            document.getElementById(tabId).classList.add('active');
            evt.currentTarget.classList.add('active');
        }
    </script>

