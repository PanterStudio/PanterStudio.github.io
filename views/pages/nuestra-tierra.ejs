            text-decoration: none;
            box-shadow: 0 4px 20px rgba(0, 176, 255, 0.3);
            transition: all 0.2s;
        }

        .btn-nt-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(0, 176, 255, 0.45);
        }

        .btn-nt-secondary {
            padding: 11px 22px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.88rem;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-nt-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

        .nt-hero-img-box {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
        }

        .nt-hero-img-box img {
            width: 100%;
            height: 100%;
            max-height: 320px;
            object-fit: cover;
            display: block;
        }

        /* Section Titles */
        .nt-sec-head {
            font-size: 1.35rem;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 1.75rem 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nt-sec-head::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255, 255, 255, 0.08);
        }

        /* Clean Grid for Features */
        .nt-features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2.5rem;
            margin-bottom: 3.5rem;
        }

        .nt-feat-card {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .nt-feat-icon {
            font-size: 1.8rem;
            margin-bottom: 0.2rem;
        }

        .nt-feat-card h3 {
            font-size: 1.1rem;
            font-weight: 800;
            color: #ffffff;
            margin: 0;
        }

        .nt-feat-card p {
            font-size: 0.9rem;
            color: #94a3b8;
            line-height: 1.6;
            margin: 0;
        }

        /* Wiki Spotlight Bar */
        .nt-wiki-spotlight {
            margin-top: 2rem;
            padding: 2rem 0;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .nt-wiki-spotlight-text h3 {
            font-size: 1.3rem;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 0.4rem 0;
        }

        .nt-wiki-spotlight-text p {
            font-size: 0.92rem;
