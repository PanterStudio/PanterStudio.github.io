            margin: 0;
        }

        .btn-wiki-green {
            padding: 12px 26px;
            background: linear-gradient(135deg, #38ef7d, #059669);
            color: #0b0f19;
            font-weight: 800;
            font-size: 0.9rem;
            border-radius: 12px;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(56, 239, 125, 0.25);
            transition: all 0.2s;
        }

        .btn-wiki-green:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(56, 239, 125, 0.4);
        }
    </style>`
  }) %>

    <!-- MAIN CONTENT -->
    <main class="nt-wrap">

        <!-- HERO PRINCIPAL DEL JUEGO -->
        <section class="nt-hero-main">
            <div>
                <div class="nt-tag">🚜 SIMULADOR DE TRABAJO & VIDA</div>
