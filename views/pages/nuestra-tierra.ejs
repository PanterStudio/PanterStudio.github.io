<%- include('partials/header', { 
    title: 'Nuestra Tierra Job Simulator — Panter Studio', 
    currentPage: 'nuestra-tierra',
    description: 'Pagina oficial de Nuestra Tierra Job Simulator. Explora el mapa, descubre los trabajos, vehiculos y unete a las pruebas de beta tester.',
    extraHead: `<style>
        :root {
