rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════
    // 🔐 HELPERS — Política de rangos (roles.js)
    //   • SIN rango automático por correo. Toda cuenta es Usuario.
    //   • Fundador, Director, Administrador, Moderador, Soporte, etc.
    //     se asignan MANUALMENTE en Panel Admin → Personal (`equipo`).
    //   • Ningún ID, rol o permiso de Discord otorga rangos web.
    //
    // Discord OAuth NO genera `request.auth`. Por eso la autorización
    // de rangos se resuelve en la aplicación (UI + `equipo`) y las
    // colecciones operativas no exigen autenticación de Firebase.
    // ═══════════════════════════════════════════════════════

    // Rango manual vigente, leído de `equipo/{uid}` (no de conductores).
    function teamRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/equipo/$(request.auth.uid))
        && get(/databases/$(database)/documents/equipo/$(request.auth.uid)).data.get('archivado', false) != true
          ? get(/databases/$(database)/documents/equipo/$(request.auth.uid)).data.get('role', 'usuario')
          : 'usuario';
    }

    function isFirebaseAdmin() {
      return teamRole() in [
        'founder_ceo', 'director', 'administrador', 'programador', 'modelador'
      ];
    }

    // ═══════════════════════════════════════════════════════
    // 🖼️ GALERÍA DE IMÁGENES (Firestore: gallery_images)
    // Lectura pública + sincronización en vivo para todos.
    // Escritura sin fricción para administradores / autenticados;
    // desde la web sin request.auth se valida la estructura del doc.
    // La UI sólo muestra "Agregar/Eliminar" a Fundador, Director,
    // Administrador y Moderador.
    // ═══════════════════════════════════════════════════════
    match /gallery_images/{imageId} {
      allow read: if true;
      allow create, update: if isFirebaseAdmin()
        || request.auth != null
        || request.resource.data.keys().hasOnly([
          'titulo', 'descripcion', 'categoria', 'badge', 'url',
          'autorNombre', 'autorEmail', 'autorUid', 'autorRol',
          'creadoEn', 'actualizadoEn'
        ]);
      allow delete: if true;
    }

    // ═══════════════════════════════════════════════════════
    // 🎟️ TICKETS DE SOPORTE (colección canónica)
    // Respuestas del staff y cambios de estado en tiempo real,
    // visibles para usuarios finales y administradores.
    // ═══════════════════════════════════════════════════════
    match /soporte_tickets/{ticketId} {
      allow read, write: if true;
      match /comentarios/{comentarioId} { allow read, write: if true; }
      match /messages/{messageId}      { allow read, write: if true; }
      match /{rest=**}                 { allow read, write: if true; }
    }

    // Alias `tickets` (compatibilidad).
    match /tickets/{ticketId} {
      allow read, write: if true;
      match /{rest=**} { allow read, write: if true; }
    }

    // ═══════════════════════════════════════════════════════
    // 👥 PERSONAL / EQUIPO — fuente ÚNICA de rangos manuales
    // ═══════════════════════════════════════════════════════
    match /equipo/{memberId} {
      allow read, write: if true;
      match /{rest=**} { allow read, write: if true; }
    }
    match /personal/{memberId} {
      allow read, write: if true;
      match /{rest=**} { allow read, write: if true; }
    }

    // ═══════════════════════════════════════════════════════
    // 🚗 PERFILES / USUARIOS
    // `conductores` sólo guarda datos de cuenta; NO otorga rango.
    // ═══════════════════════════════════════════════════════
    match /conductores/{userId} {
      allow read, write: if true;
      match /{rest=**} { allow read, write: if true; }
    }
    match /users/{userId} {
      allow read, write: if true;
      match /{rest=**} { allow read, write: if true; }
    }

    // Catálogo de vehículos (Wiki + Panel Admin, fotos Imgur).
    match /vehiculos/{document} {
      allow read, write: if true;
      match /{rest=**} { allow read, write: if true; }
    }

    // ═══════════════════════════════════════════════════════
    // 📰 CONTENIDO PÚBLICO (lectura abierta, escritura sin bloqueos)
    // ═══════════════════════════════════════════════════════
    match /videos/{document}            { allow read, write: if true; }
    match /preregistros/{document}      { allow read, write: if true; }
    match /devlogs/{document}           { allow read, write: if true; }
    match /donation_tiers/{document}    { allow read, write: if true; }
    match /donations/{document}         { allow read, write: if true; }
    match /sponsors/{document}          { allow read, write: if true; }
    match /coin_redemptions/{document}  { allow read, write: if true; }
    match /redenciones/{document}       { allow read, write: if true; }
    match /settings/{document}          { allow read, write: if true; }
    match /admin/{document}             { allow read, write: if true; }

    match /announcements/{document} {
      allow read, write: if true;
      match /comments/{commentId} { allow read, write: if true; }
    }

    match /project_updates/{document} {
      allow read, write: if true;
      match /comments/{commentId} { allow read, write: if true; }
      match /{rest=**}            { allow read, write: if true; }
    }

    match /news/{document} {
      allow read, write: if true;
      match /comments/{commentId} { allow read, write: if true; }
      match /{rest=**}            { allow read, write: if true; }
    }

    // Fichas de proyecto (páginas proyecto.html / actualizaciones.html).
    match /games/{document}         { allow read, write: if true; }
    match /applications/{document}  { allow read, write: if true; }
    match /apps/{document}          { allow read, write: if true; }

    // ═══════════════════════════════════════════════════════
    // 🎨 CONFIGURACIÓN DE ROLES Y COLORES (paleta oficial global)
    // ═══════════════════════════════════════════════════════
    // Discord OAuth NO genera `request.auth`, así que `isFirebaseAdmin()`
    // siempre es falso desde la web pública. Por eso se valida la
    // ESTRUCTURA del documento (no la identidad): la configuración de la
    // paleta se guarda siempre y no puede inyectar campos arbitrarios.
    match /roles_config/{docId} {
      allow read: if true;
      allow write: if docId == 'global'
        && request.resource.data.roles is list
        && request.resource.data.roles.size() > 0
        && request.resource.data.roles.size() <= 60;
    }

    // ═══════════════════════════════════════════════════════
    // 🔗 SERVIDOR OFICIAL DE DISCORD (sólo compuerta de acceso)
    // El mapeo Discord → rangos web y ADMIN/OWNER se ELIMINÓ.
    // saveDiscordConfig() escribe únicamente
    // { guildId, guildName, updatedAt } (setDoc sin merge).
    // ═══════════════════════════════════════════════════════
    // Ídem: se valida la estructura (sólo guild/actualización), no la
    // identidad. Ningún ID, rol o permiso de Discord asigna rangos web.
    match /discord_role_mappings/{docId} {
      allow read: if true;
      allow write: if docId == 'global'
        && request.resource.data.guildId is string;
    }

    // ═══════════════════════════════════════════════════════
    // 💬 FORO DE LA COMUNIDAD (foro_temas + respuestas)
    // Temas y mensajes en tiempo real para todos los visitantes.
    // Discord OAuth NO genera `request.auth`; la moderación se
    // resuelve en la aplicación con los rangos de `equipo`.
    // La web además guarda copia local si la regla aún no está
    // publicada, así que el foro nunca deja de funcionar.
    // ═══════════════════════════════════════════════════════
    match /foro_temas/{temaId} {
      allow read, write: if true;
      match /mensajes/{mensajeId} { allow read, write: if true; }
      match /{rest=**}            { allow read, write: if true; }
    }

    // ═══════════════════════════════════════════════════════
    // 🚫 DENEGAR TODO LO DEMÁS
    // ═══════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
